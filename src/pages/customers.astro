---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Testimonials from '../components/Testimonials.astro';
import { organizationSchema, breadcrumbSchema } from '../data/schema';
import { caseStudies } from '../data/caseStudies';

const path = '/customers';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Customers', path }];
const sorted = [...caseStudies].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
---
<Layout
  title="Customers | Keres AI"
  description="Customer stories from businesses that use Keres AI. Published only with the customer's permission; until then, estimate your own numbers with the missed-call calculator."
  path={path}
  noindexFollow
>
  <Schema slot="head" graph={[breadcrumbSchema(crumbs), organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />
  <header class="page-hero container">
    <span class="eyebrow">Customers</span>
    <h1>Customer stories, <span class="accent">published with permission</span></h1>
    <p class="lead">We only publish a customer story when the customer has agreed to it and the numbers are theirs. Until then, run your own numbers or hear an example call.</p>
    <div class="hero-ctas">
      <a href="/quote" class="btn btn-primary">Get a quote</a>
    </div>
  </header>

  {sorted.length > 0 && (
    <section class="page-section container">
      <div class="section-label">Case studies</div>
      <div class="feature-grid">
        {sorted.map((cs) => (
          <a class="feature-card" href={`/customers/${cs.slug}`} style="text-decoration:none; display:block;">
            <div class="plan" style="font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--orange);margin-bottom:10px">{cs.industry}</div>
            <h3>{cs.headline}</h3>
            <p>{cs.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <Testimonials />

  <section class="page-section container">
    <div class="section-label">Featured story</div>
    <div class="feature-grid">
      <a class="feature-card" href="/hear-it" style="text-decoration:none; display:block;">
        <div class="plan" style="font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--orange);margin-bottom:10px">Example calls</div>
        <h3>Hear how Remi handles a call</h3>
        <p>Example transcripts by trade. Examples, not recordings of customers.</p>
      </a>
      <a class="feature-card" href="/tools/missed-call-calculator" style="text-decoration:none; display:block;">
        <div class="plan" style="font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--orange);margin-bottom:10px">Estimate your own</div>
        <h3>What are missed calls costing you?</h3>
        <p>Run the numbers for your business and see the revenue you could recover.</p>
      </a>
    </div>
  </section>

  <CtaBand heading="Be the next result" sub="Book a free 30-minute call and see Keres answer and book a call live." />
</Layout>
