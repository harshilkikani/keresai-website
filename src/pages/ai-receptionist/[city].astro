---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { organizationSchema, faqSchema, breadcrumbSchema, webPageSchema } from '../../data/schema';
import { cities, stateSlug } from '../../data/cities';
import { industries } from '../../data/industries';
import { geoVerticalsForCity } from '../../data/geoVerticals';

export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const ORIGIN = 'https://www.keresai.com';
const path = `/ai-receptionist/${c.slug}`;
const statePath = `/ai-receptionist/state/${stateSlug(c.stateFull)}`;
const cityVerticals = geoVerticalsForCity(c.slug);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'AI Receptionist', path: '/ai-receptionist' },
  { name: c.stateFull, path: statePath },
  { name: `${c.city}, ${c.state}`, path },
];

const faqs = [
  c.faq,
  {
    q: `How fast does Keres answer calls in ${c.city}?`,
    a: `Every call is answered within two rings, 24/7 — including nights, weekends, and holidays — so no ${c.city}-area lead ever reaches voicemail.`,
  },
  {
    q: 'Do I keep my existing phone number?',
    a: 'Yes. You point your existing number at Keres — no porting, no new hardware. Most accounts go live within five business days.',
  },
  {
    q: `What industries does Keres serve in ${c.city}?`,
    a: `Keres serves HVAC, plumbing, roofing, towing, septic, dental, med spa, real estate, and professional services businesses across ${c.city} and the surrounding ${c.stateFull} metro.`,
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${ORIGIN}${path}#service`,
  name: `AI Receptionist in ${c.city}, ${c.state}`,
  serviceType: 'AI Receptionist',
  description: `24/7 AI receptionist for ${c.city}, ${c.stateFull} businesses — answers every call, qualifies leads, and books appointments automatically.`,
  url: ORIGIN + path,
  provider: { '@id': `${ORIGIN}/#organization` },
  areaServed: [
    { '@type': 'City', name: c.city, containedInPlace: { '@type': 'State', name: c.stateFull } },
    { '@type': 'AdministrativeArea', name: `${c.city} metro, ${c.stateFull}` },
  ],
  audience: {
    '@type': 'Audience',
    audienceType: 'Service businesses and contractors',
    geographicArea: { '@type': 'City', name: c.city },
  },
};

const webpage = webPageSchema({
  path,
  name: `AI Receptionist in ${c.city}, ${c.state} — Answer Every Call 24/7 | Keres AI`,
  description: `Keres AI is a 24/7 AI receptionist for ${c.city}, ${c.stateFull} businesses. Answer every call, book appointments, and never miss a lead.`,
  speakableSelectors: ['.answer-block', '.faq-a', '.lead'],
});

// Top home-services industries for this city — link to vertical pages
const homeServiceVerticals = industries.filter((i) =>
  ['hvac', 'plumbers', 'roofing', 'towing', 'septic'].includes(i.slug)
);
const professionalVerticals = industries.filter((i) =>
  ['dentists', 'med-spas', 'real-estate', 'professional-intake'].includes(i.slug)
);

// Other city pages (up to 6 nearest — displayed as cross-links)
const otherCities = cities.filter((x) => x.slug !== c.slug).slice(0, 8);
---
<Layout
  title={`AI Receptionist in ${c.city}, ${c.state} — Answer Every Call 24/7 | Keres AI`}
  description={`Keres AI is a 24/7 AI receptionist for ${c.city}, ${c.stateFull} businesses. Answer every call, book appointments, and never miss a lead — day or night. Book a demo.`}
  path={path}
>
  <Schema slot="head" graph={[serviceSchema, webpage, faqSchema(faqs), breadcrumbSchema(crumbs), organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />

  <header class="page-hero container">
    <span class="eyebrow">AI Receptionist · {c.city}, {c.state}</span>
    <h1>The 24/7 AI receptionist for <span class="accent">{c.city} businesses</span></h1>
    <p class="lead">{c.intro}</p>
    <div class="hero-ctas">
      <a href="/demo" class="btn btn-primary">Book a Demo</a>
      <a href="/tools/missed-call-calculator" class="btn btn-outline">Calculate missed-call losses</a>
    </div>
  </header>

  <!-- DIRECT ANSWER BLOCK -->
  <section class="page-section container">
    <div class="answer-block" itemscope itemtype="https://schema.org/Answer">
      <p itemprop="text">Keres AI is a <strong>24/7 AI receptionist for {c.city}, {c.state}</strong> businesses. It answers every inbound call in two rings, qualifies the caller, books the appointment on your calendar, and texts your team the moment a call is an emergency — so no {c.city}-area lead is lost to voicemail, day or night.</p>
    </div>
  </section>

  <!-- LOCAL DEMAND DRIVERS -->
  <section class="page-section container">
    <div class="prose">
      <h2>Why {c.city} businesses miss calls — and what it costs</h2>
      <ul>
        {c.drivers.map((d) => <li>{d}</li>)}
      </ul>
      <p>Every unanswered call is a {c.city} customer calling the next business on the list. Keres closes that gap by answering instantly, every time — including the after-hours and surge calls that your front desk can't absorb.</p>
    </div>
  </section>

  <!-- WHAT KERES DOES -->
  <section class="page-section container">
    <div class="section-label">What Keres does</div>
    <h2 class="section-title" style="margin-bottom:8px">Answer, qualify, and book — automatically</h2>
    <div class="feature-grid">
      <div class="feature-card">
        <h3>Answer every call 24/7</h3>
        <p>Two-ring pickup, nights and weekends included. No voicemail, no hold music, ever.</p>
      </div>
      <div class="feature-card">
        <h3>Book on your calendar</h3>
        <p>Checks live availability and books or reschedules during the call — no callback promise.</p>
      </div>
      <div class="feature-card">
        <h3>Qualify and capture leads</h3>
        <p>Asks your questions, captures all details, and syncs the lead to your CRM automatically.</p>
      </div>
      <div class="feature-card">
        <h3>Dispatch emergencies instantly</h3>
        <p>Texts your on-call team the moment a call is an urgent job — address, situation, contact included.</p>
      </div>
    </div>
  </section>

  <!-- SOFT CTA -->
  <div class="container" style="margin-bottom:var(--space-6)">
    <div class="inline-cta-row">
      <a href="/use-cases/after-hours-answering" class="inline-cta-link">→ After-hours answering</a>
      <a href="/use-cases/overflow-call-handling" class="inline-cta-link">→ Overflow call handling</a>
      <a href="/glossary/lead-response-time" class="inline-cta-link">→ Why speed to lead matters</a>
    </div>
  </div>

  <!-- VERTICAL LINKS — home services -->
  <section class="page-section container">
    <div class="section-label">By industry</div>
    <h2 class="section-title" style="margin-bottom:8px">Built for every {c.city} service business</h2>
    <p class="prose" style="margin-bottom:var(--space-4)">Keres handles the specific call flows, integrations, and emergency patterns of each industry — not a generic answering service.</p>
    <div class="feature-grid">
      {homeServiceVerticals.map((i) => (
        <a class="feature-card" href={`/ai-receptionist-for-${i.slug}`} style="text-decoration:none;display:block">
          <h3>AI receptionist for {i.short}</h3>
          <p>{i.intro.slice(0, 100)}…</p>
        </a>
      ))}
      {professionalVerticals.map((i) => (
        <a class="feature-card" href={`/ai-receptionist-for-${i.slug}`} style="text-decoration:none;display:block">
          <h3>AI receptionist for {i.short}</h3>
          <p>{i.intro.slice(0, 100)}…</p>
        </a>
      ))}
    </div>
  </section>

  <!-- MEDIUM CTA -->
  <div class="container" style="margin-bottom:var(--space-6)">
    <div class="soft-cta-card">
      <div class="soft-cta-body">
        <h3 class="soft-cta-heading">What are missed {c.city} calls costing you?</h3>
        <p class="soft-cta-sub">Estimate the monthly revenue lost to unanswered calls based on your industry and call volume.</p>
      </div>
      <a href="/tools/missed-call-calculator" class="btn btn-outline">Open the calculator →</a>
    </div>
  </div>

  {cityVerticals.length > 0 && (
    <section class="page-section container">
      <div class="section-label">Popular {c.city} trades</div>
      <h2 class="section-title" style="margin-bottom:8px">{c.city} AI receptionist by trade</h2>
      <p class="prose" style="margin-bottom:var(--space-4)">Deep, local coverage for the trades that lose the most to missed calls in {c.city}:</p>
      <div class="feature-grid">
        {cityVerticals.map((g) => (
          <a class="feature-card" href={`/ai-receptionist/${g.citySlug}/${g.verticalSlug}`} style="text-decoration:none;display:block">
            <h3>{c.city} {g.verticalLabel} receptionist</h3>
            <p>{g.angle.slice(0, 120)}…</p>
            <span class="inline-cta-link" style="margin-top:8px;display:inline-block">{c.city} {g.verticalLabel} →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <FaqSection faqs={faqs} title={`AI receptionist in ${c.city} — FAQ`} />

  <!-- OTHER CITIES -->
  <section class="page-section container">
    <div class="section-label">Other markets</div>
    <h2 class="section-title" style="margin-bottom:8px">AI receptionist by city</h2>
    <p class="prose" style="margin-bottom:14px">
      {otherCities.map((x, i) => (
        <>{i > 0 ? ' · ' : ''}<a href={`/ai-receptionist/${x.slug}`}>{x.city}, {x.state}</a></>
      ))}
    </p>
    <p class="prose">See all <a href={statePath}>{c.stateFull} coverage</a> · <a href="/ai-receptionist">all AI receptionist features →</a></p>
  </section>

  <CtaBand heading={`Stop losing ${c.city} leads to voicemail`} sub="Book a free 30-minute demo and watch Keres answer and book a call live." />
</Layout>
