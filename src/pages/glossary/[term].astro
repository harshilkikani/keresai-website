---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import {
  organizationSchema,
  faqSchema,
  breadcrumbSchema,
  definedTermSchema,
  webPageSchema,
} from '../../data/schema';
import { NOINDEX_GLOSSARY } from '../../seo/indexing.mjs';
import { glossary } from '../../data/glossary';

export function getStaticPaths() {
  return glossary.map((t) => ({ params: { term: t.slug }, props: { t } }));
}

const { t } = Astro.props;
const path = `/glossary/${t.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Glossary', path: '/glossary' },
  { name: t.term, path },
];

const related = t.related
  .map((slug) => glossary.find((g) => g.slug === slug))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

const cleanDefinition = t.definition.replace(/<[^>]+>/g, '');
const shortTerm = t.term.replace(/\s*\(.*\)\s*/, '');
const h1 = t.h1 ?? `What is ${shortTerm}?`;
// Section bodies that start with a block tag (<p>, <ol>, <ul>) render in a div, not a <p>.
const isBlock = (html: string) => /^\s*<(p|ol|ul)[\s>]/.test(html);

// Soft CTA: sends informational readers to the most relevant product/use-case page
// rather than jumping straight to demo — matches where they are in the funnel.
const softCtaMap: Record<string, { href: string; label: string; context: string }> = {
  'AI Receptionist': {
    href: t.cta?.href ?? '/agents/inbound',
    label: 'See how it works for your industry →',
    context: 'See the product behind this concept',
  },
  'AI SDR & Outbound': {
    href: t.cta?.href ?? '/agents/outbound',
    label: 'See the AI SDR →',
    context: 'See outbound in action',
  },
  'Email Deliverability': {
    href: t.cta?.href ?? '/agents/outbound',
    label: 'Fix your deliverability →',
    context: 'See deliverability tools',
  },
  'Local Search': {
    href: t.cta?.href ?? '/services/found',
    label: 'See what Found manages →',
    context: 'See the service behind this concept',
  },
};
const isLocal = t.category === 'Local Search';
const isEmail = /email|outbound|sdr/i.test(t.category);
const softCta = softCtaMap[t.category];

const webpage = webPageSchema({
  path,
  name: t.title,
  description: t.description,
  speakableSelectors: ['.answer-block', '.faq-a'],
});
// Thin email/outbound definitions that compete with vendor docs on a product
// (Sol) that is not the focus: noindex until consolidated into one guide.
// One list (src/seo/indexing.mjs) shared with the sitemap and llms.txt.
const THIN_EMAIL_TERMS = NOINDEX_GLOSSARY;
---
<Layout title={t.title} description={t.description} path={path} noindexFollow={THIN_EMAIL_TERMS.includes(t.slug)}>
  <Schema slot="head" graph={[
    definedTermSchema({ term: t.term, definition: cleanDefinition, path }),
    faqSchema(t.faqs),
    webpage,
    breadcrumbSchema(crumbs),
    organizationSchema,
  ]} />

  <Breadcrumbs crumbs={crumbs} />

  <header class="page-hero container">
    <span class="eyebrow">Keres AI glossary · {t.category}</span>
    <h1>{h1}</h1>
  </header>

  <!-- DIRECT ANSWER BLOCK — marked speakable and as schema.org Answer for AI retrieval -->
  <section class="page-section container">
    <div class="answer-block" id={`${t.slug}-definition`}>
      <p set:html={t.definition} />
    </div>
  </section>

  <!-- DEPTH SECTIONS -->
  {t.sections.map((s) => (
    <section class="page-section container">
      <div class="prose">
        <h2>{s.h2}</h2>
        {isBlock(s.body) ? <div set:html={s.body} /> : <p set:html={s.body} />}
      </div>
    </section>
  ))}

  <!-- SOFT CTA — bridges informational intent to product before asking for demo -->
  {softCta && (
    <div class="container" style="margin:var(--space-4) 0">
      <div class="soft-cta-card">
        <div class="soft-cta-body">
          <p class="soft-cta-label">{softCta.context}</p>
          <h3 class="soft-cta-heading">Want to see {t.term.replace(/\s*\(.*\)\s*/, '')} working in practice?</h3>
          <p class="soft-cta-sub">See how Keres puts it to work for your vertical and workflow.</p>
        </div>
        <a href={softCta.href} class="btn btn-outline">{softCta.label}</a>
      </div>
    </div>
  )}

  <!-- MEDIUM CTA — calculator for revenue-related terms -->
  {['missed-call-recovery', 'missed-call-text-back', 'lead-response-time', 'after-hours-answering', 'front-desk-automation'].includes(t.slug) && (
    <div class="container" style="margin-bottom:var(--space-4)">
      <div class="soft-cta-card soft-cta-card--secondary">
        <div class="soft-cta-body">
          <h3 class="soft-cta-heading">How much is this costing your business?</h3>
          <p class="soft-cta-sub">Plug in your call volume and average job value to see the monthly revenue at risk.</p>
        </div>
        <a href="/tools/missed-call-calculator" class="btn btn-outline">Open the calculator →</a>
      </div>
    </div>
  )}

  <!-- RELATED TERMS -->
  {related.length > 0 && (
    <section class="page-section container">
      <div class="section-label">Related terms</div>
      <div class="feature-grid">
        {related.map((r) => (
          <a class="feature-card" href={`/glossary/${r.slug}`} style="text-decoration:none; display:block;">
            <h3>{r.term}</h3>
            <p>{r.definition.replace(/<[^>]+>/g, '').slice(0, 120)}…</p>
          </a>
        ))}
      </div>
      <p class="prose" style="margin-top:18px"><a href="/glossary">← Back to the full glossary</a></p>
    </section>
  )}

  <FaqSection faqs={t.faqs} title={`${t.term.replace(/\s*\(.*\)\s*/, '')} — FAQ`} />

  <!-- HARD CTA — only after full content consumed -->
  <CtaBand
    heading={isLocal ? 'Get found, then get the call answered' : isEmail ? 'See how Sol runs outbound email' : t.cta ? `See ${shortTerm} working live` : 'Stop losing leads to voicemail'}
    sub={isLocal
      ? 'Book a free 20-minute call to go through your Google profile, reviews and listings, and what Found would manage for you.'
      : isEmail
        ? 'Book a free 20-minute call to go through your sending domains, your list and what Sol would send for you.'
        : 'Book a free 20-minute call and hear Remi answer, qualify and book a call.'}
    cta={t.cta ? t.cta.label : 'Book a 20-minute call'}
    href={t.cta ? t.cta.href : '/quote'}
  />
</Layout>
