---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { organizationSchema, faqSchema, breadcrumbSchema, serviceSchema } from '../../data/schema';
import { integrations, isLive, rollingOutNote, liveIntegrationNames } from '../../data/integrations';

export function getStaticPaths() {
  return integrations.map((i) => ({ params: { tool: i.slug }, props: { i } }));
}

const { i } = Astro.props;
const path = `/integrations/${i.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Integrations', path: '/integrations' },
  { name: i.name, path },
];
const related = i.related
  .map((slug) => integrations.find((g) => g.slug === slug))
  .filter((g): g is NonNullable<typeof g> => Boolean(g))
  // Indexable (live) pages link only to other live integrations.
  .filter((g) => !isLive(i) || isLive(g));
const live = isLive(i);
const note = rollingOutNote(i.name);
// A rolling-out integration never claims to work: honest title, intro and FAQ,
// and noindex until it ships.
const title = live ? i.title : `${i.name} Integration (Rolling Out) | Keres AI`;
const description = live ? i.description : `The Keres AI + ${i.name} integration is rolling out, not live yet. Keres connects to ServiceTitan, HubSpot, Google Calendar and Zapier today.`;
const faqs = live ? i.faqs : [
  { q: `Is the Keres AI + ${i.name} integration live?`, a: `Not yet. ${note} Ask on a call where ${i.name} is on the list.` },
  { q: `What can I use until ${i.name} is connected?`, a: `Remi books into ${liveIntegrationNames.join(', ')} today, and the morning text summarizes every call so nothing depends on the sync.` },
];
const blurb = (g: typeof i) => (isLive(g) ? g.intro.slice(0, 110) + '…' : `Rolling out. Not live yet.`);
---
<Layout title={title} description={description} path={path} noindexFollow={!live}>
  <Schema slot="head" graph={[
    // A rolling-out integration is not a service anyone can buy yet.
    ...(live ? [serviceSchema({
      name: `Keres AI + ${i.name} integration`,
      serviceType: 'AI receptionist integration',
      description,
      path,
    })] : []),
    faqSchema(faqs),
    breadcrumbSchema(crumbs),
    organizationSchema,
  ]} />

  <Breadcrumbs crumbs={crumbs} />
  <div class="page-hero container">
    <span class="eyebrow">{i.category} · {live ? 'Integration' : 'Rolling out'}</span>
    <h1>Keres AI + <span class="accent">{i.name}</span></h1>
    <div class="hero-ctas">
      <a href="/quote" class="btn btn-primary">Get a quote</a>
      <a href="/integrations" class="btn btn-outline">All integrations</a>
    </div>
  </div>

  <section class="page-section container">
    <div class="answer-block">
      <p>{live ? i.intro : note}</p>
    </div>
  </section>

  <section class="page-section container">
    <div class="section-label">{live ? 'What it does' : 'What it will do'}</div>
    <h2 class="section-title" style="margin-bottom:8px">{live ? `What does Keres AI do in ${i.name}?` : `What will Keres AI do in ${i.name} once it ships?`}</h2>
    <div class="feature-grid">
      {i.does.map((d) => (
        <div class="feature-card"><h3>{d}</h3></div>
      ))}
    </div>
  </section>

  <section class="page-section container">
    <div class="prose">
      <h2>{live ? `What syncs with ${i.name}?` : `What will sync with ${i.name}?`}</h2>
      <ul>
        {i.syncs.map((s) => <li>{s}</li>)}
      </ul>
      {live
        ? <p>Setup is done for you: Keres connects {i.name} during onboarding and agrees the go-live timing with you on the first call. Pair it with the <a href="/agents/inbound">AI receptionist</a> for inbound and the <a href="/agents/outbound">AI SDR</a> for outbound.</p>
        : <p>{note} Ask on a call where {i.name} is on the list.</p>}
    </div>
  </section>

  {live && (i.setup || i.writes || i.limits) && (
    <section class="page-section container">
      <div class="prose">
        {i.setup && (<><h2>How does setup work?</h2><p>{i.setup}</p></>)}
        {i.writes && (<><h2>What does Keres AI write to {i.name}?</h2><p>{i.writes}</p></>)}
        {i.limits && (<><h2>What doesn’t sync, and what are the limits?</h2><p>{i.limits}</p></>)}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="page-section container">
      <div class="section-label">Related integrations</div>
      <div class="feature-grid">
        {related.map((r) => (
          <a class="feature-card" href={`/integrations/${r.slug}`} style="text-decoration:none; display:block;">
            <h3>Keres AI + {r.name}</h3>
            <p>{blurb(r)}</p>
          </a>
        ))}
      </div>
      <p class="prose" style="margin-top:18px"><a href="/integrations">← See all integrations</a></p>
    </section>
  )}

  <FaqSection faqs={faqs} title={`Keres AI + ${i.name} — FAQ`} />
  <CtaBand heading={live ? `Connect Keres to ${i.name}` : `Ask where ${i.name} is on the list`} sub={live ? 'Book a free 30-minute call and we’ll wire it to your exact setup.' : 'Book a free 30-minute call and we’ll tell you what works with your setup today.'} />
</Layout>
