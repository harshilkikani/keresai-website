---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { organizationSchema, breadcrumbSchema } from '../data/schema';
import { usecases } from '../data/usecases';

const path = '/use-cases';
const ORIGIN = 'https://www.keresai.com';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Use Cases', path }];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Keres AI use cases',
  itemListElement: usecases.map((u, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: u.name,
    url: `${ORIGIN}/use-cases/${u.slug}`,
  })),
};
---
<Layout
  title="Use Cases — What Keres AI Solves | Keres AI"
  description="How Keres AI handles after-hours answering, overflow calls, appointment booking, lead capture and spam screening for businesses that live on the phone."
  path={path}
  pageType="CollectionPage"
>
  <Schema slot="head" graph={[breadcrumbSchema(crumbs), itemList, organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />
  <header class="page-hero container">
    <span class="eyebrow">Use Cases</span>
    <h1>Every call, <span class="accent">handled</span></h1>
    <p class="lead answer-block">What Keres AI’s AI receptionist, Remi, does on specific jobs: overflow and storm-surge calls, emergency dispatch by your rules, lead capture and qualification, spam screening, maintenance-plan reactivation and financing follow-up. For around-the-clock coverage see <a href="/24-7-ai-receptionist">24/7 answering</a>; for booking see <a href="/agents/inbound">how Remi books</a>.</p>
    <div class="hero-ctas">
      <a href="/quote" class="btn btn-primary">Get a quote</a>
    </div>
  </header>

  <section class="page-section container">
    <h2 class="section-label">Use cases</h2>
    <div class="feature-grid">
      {usecases.map((u) => (
        <a class="feature-card" href={`/use-cases/${u.slug}`} style="text-decoration:none; display:block;">
          <h3>{u.name}</h3>
          <p>{u.intro.replace(/<[^>]+>/g, '').slice(0, 140)}…</p>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section container">
    <div class="prose">
      <h2>Which use case should you start with?</h2>
      <p>Start where calls are lost today. If the phone rings out when the team is busy, start with <a href="/use-cases/overflow-call-handling">overflow call handling</a>. If junk calls have trained your staff to ignore the phone, start with <a href="/use-cases/spam-call-screening">spam-call screening</a>. If you pay for leads that wait hours for a callback, start with <a href="/use-cases/lead-capture">lead capture and qualification</a>. Roofers and HVAC companies usually add <a href="/use-cases/storm-response-dispatch">storm-response dispatch</a> or <a href="/use-cases/emergency-dispatch">emergency dispatch</a> before their busy season.</p>
      <h2>How do they fit together?</h2>
      <p>Every use case on this page runs on the same worker. Remi answers in two rings, 24/7, asks your intake questions, books into Google Calendar, HubSpot or ServiceTitan, and texts back any caller it could not take within 60 seconds. Remi also handles website chat, your business text line and website form enquiries, and answers in English. What changes from one use case to the next is the script and the rules you set on your first call. Two jobs bring in other workers: <a href="/use-cases/maintenance-plan-reactivation">maintenance-plan reactivation</a> uses June to work your list of lapsed customers, and <a href="/use-cases/financing-follow-up">financing follow-up</a> hands financing-qualified leads to your sales team.</p>
      <h2>What does it cost?</h2>
      <p>Remi is one monthly rate with included minutes, then per minute, with no per-call fees, month-to-month. Keres sets it up for you and quotes the rate to your call volume on a 30-minute call. See <a href="/pricing">pricing</a> or <a href="/hear-it">hear example calls</a>.</p>
    </div>
  </section>

  <CtaBand heading="See it solve yours" sub="Book a free 30-minute call and hear Remi answer, qualify and book a call." />
</Layout>
