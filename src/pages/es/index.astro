---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import HomePage from '../../components/HomePage.astro';
import { organizationSchema, softwareApplicationSchema, websiteSchema, faqSchema } from '../../data/schema';
import { homeCopy, faqsFor } from '../../i18n/home';
const c = homeCopy('es');
---
<Layout title={c.title} description={c.description} path="/es" locale="es" quoteHref="#lead">
  <Schema slot="head" graph={[organizationSchema, softwareApplicationSchema, websiteSchema, faqSchema(faqsFor('es'))]} />
  <HomePage locale="es" />
  <script slot="scripts" src="/assets/roi.js?v=7" defer is:inline></script>
  <script slot="scripts" src="/assets/quote.js?v=4" defer is:inline></script>
</Layout>
