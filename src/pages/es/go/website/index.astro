---
import Layout from '../../../../layouts/Layout.astro';
import Schema from '../../../../components/Schema.astro';
import GoWebsitePage from '../../../../components/GoWebsitePage.astro';
import { organizationSchema } from '../../../../data/schema';
import { goWebsitePagesFor } from '../../../../i18n/data';
const page = goWebsitePagesFor('es').find((g) => g.slug === '')!;
---
<Layout title={page.title} description={page.description} path={page.path} go noindex locale="es">
  <Schema slot="head" graph={[organizationSchema]} />
  <GoWebsitePage page={page} locale="es" />
  <script slot="scripts" src="/assets/quote.js?v=3" defer is:inline></script>
</Layout>
