---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import CustomPage from '../../components/CustomPage.astro';
import { organizationSchema } from '../../data/schema';
import { customCopy } from '../../i18n/custom';
const c = customCopy('es');
---
<Layout title={c.title} description={c.description} path="/es/custom" locale="es">
  <Schema slot="head" graph={[organizationSchema]} />
  <CustomPage locale="es" />
  <script slot="scripts" src="/assets/quote.js?v=3" defer is:inline></script>
</Layout>
