---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import CustomPage from '../../components/CustomPage.astro';
import { organizationSchema, faqSchema, breadcrumbSchema, workerServiceSchemasEs } from '../../data/schema';
import { customCopy, customFaqs } from '../../i18n/custom';
const c = customCopy('es');
---
<Layout title={c.title} description={c.description} path="/es/custom" locale="es">
  <Schema slot="head" graph={[organizationSchema, faqSchema(customFaqs('es')), ...workerServiceSchemasEs({ includes: true }).filter((n) => n['@id'].endsWith('/custom#service')), breadcrumbSchema([{ name: 'Inicio', path: '/es' }, { name: 'Trabajadores de IA a medida', path: '/es/custom' }])]} />
  <CustomPage locale="es" />
  <script slot="scripts" src="/assets/quote.js?v=4" defer is:inline></script>
</Layout>
