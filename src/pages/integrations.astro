---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { organizationSchema, breadcrumbSchema } from '../data/schema';
import { integrations, integrationCategories, isLive, liveIntegrationNames } from '../data/integrations';

const path = '/integrations';
const ORIGIN = 'https://www.keresai.com';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Integrations', path }];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Keres AI integrations',
  itemListElement: integrations.filter(isLive).map((i, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `Keres AI + ${i.name}`,
    url: `${ORIGIN}/integrations/${i.slug}`,
  })),
};
---
<Layout
  title="Integrations — Connect Keres AI to Your Stack | Keres AI"
  description="Keres AI connects to Google Calendar, HubSpot, ServiceTitan and Zapier today. Jobber, Housecall Pro, Outlook and others are rolling out and marked that way."
  path={path}
>
  <Schema slot="head" graph={[breadcrumbSchema(crumbs), itemList, organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />
  <header class="page-hero container">
    <span class="eyebrow">Integrations</span>
    <h1>Plugs into <span class="accent">your stack</span></h1>
    <p class="lead">Connected today: {liveIntegrationNames.join(', ')}. The rest are rolling out and marked that way below.</p>
    <div class="hero-ctas">
      <a href="/quote" class="btn btn-primary">Book a Demo</a>
    </div>
  </header>

  {integrationCategories.map((cat) => (
    <section class="page-section container">
      <div class="section-label">{cat}</div>
      <div class="feature-grid">
        {integrations.filter((i) => i.category === cat).sort((a, b) => Number(isLive(b)) - Number(isLive(a))).map((i) => (
          <a class="feature-card" href={`/integrations/${i.slug}`} style="text-decoration:none; display:block;">
            <h3>Keres AI + {i.name}</h3>
            <p>{isLive(i) ? i.intro.slice(0, 130) + '…' : 'Rolling out. Not live yet.'}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="page-section container">
    <div class="prose">
      <p>Don’t see your stack? <a href="/quote">Book a call</a> and tell us what you run on; we’ll say plainly whether it works today.</p>
    </div>
  </section>

  <CtaBand heading="Connect Keres to your tools" sub="Book a free 20-minute call and we’ll map the integration to your exact stack." />
</Layout>
