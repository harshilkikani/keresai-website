---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  organizationSchema,
  faqSchema,
  breadcrumbSchema,
  serviceSchema,
  videoObjectSchema,
  webPageSchema,
} from '../data/schema';
import { industries, type Industry, type TradeContent } from '../data/industries';
import { guidesFor } from '../data/guides';

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { industry: ind.slug }, props: { ind } }));
}

// Every page that still builds is a field-service trade with its own content.
// Almost nothing below is shared between trades: the page is the trade data.
const { ind } = Astro.props as { ind: Industry };
const t = ind.trade as TradeContent;
if (!t) throw new Error(`industries.ts: "${ind.slug}" builds a page but has no trade content`);
const path = `/ai-receptionist-for-${ind.slug}`;

// The single page that carries the demo video (and its VideoObject schema).
const showVideo = ind.slug === 'hvac';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Industries', path: '/industries' },
  { name: 'Home services', path: '/industries/home-services' },
  { name: `For ${ind.short}`, path },
];

const video = videoObjectSchema({
  name: 'Keres AI receptionist: example call and operator portal',
  description: 'An example of Remi answering a call, qualifying the caller and booking the appointment, then the operator portal the owner sees. Demo account, not a customer.',
  contentUrl: '/assets/video/ai-receptionist.mp4',
  thumbnailUrl: '/assets/img/operator-portal.webp',
  uploadDate: '2026-05-25',
  duration: 'PT7M57S',
});

const webpage = webPageSchema({
  path,
  name: ind.title,
  description: ind.description,
  speakableSelectors: ['.answer-block', '.faq-a', '.lead'],
});

const guides = guidesFor(ind.slug);
const peers = industries.filter((i) => i.slug !== ind.slug);
---
<Layout title={ind.title} description={ind.description} path={path}>
  <Schema slot="head" graph={[
    serviceSchema({
      name: `AI Receptionist for ${ind.name}`,
      serviceType: 'AI Receptionist',
      description: ind.description,
      path,
      audience: ind.name,
    }),
    ...(showVideo ? [video] : []),
    webpage,
    faqSchema(ind.faqs),
    breadcrumbSchema(crumbs),
    organizationSchema,
  ]} />

  <Breadcrumbs crumbs={crumbs} />

  <header class="page-hero container">
    <span class="eyebrow">AI Receptionist · {ind.short}</span>
    <h1>The AI receptionist built for <span class="accent">{ind.nameLower}</span></h1>
    <p class="lead">{ind.intro}</p>
    <div class="hero-ctas">
      <a href="/quote" class="btn btn-primary">Book a Demo</a>
      <a href={t.calculator.href} class="btn btn-outline">Open the {t.calculator.label}</a>
    </div>
  </header>

  <!-- DIRECT ANSWER (AI citation target) -->
  <section class="page-section container">
    <div class="answer-block"><p set:html={t.answer} /></div>
  </section>

  <section class="page-section container">
    <div class="prose">
      <h2>{t.painsH2}</h2>
      <ul>{ind.pains.map((p) => <li>{p}</li>)}</ul>
      <p>{t.painsNote}</p>
    </div>
  </section>

  <!-- EXAMPLE CALL -->
  <section class="page-section container" aria-labelledby="trade-call">
    <div class="prose">
      <h2 id="trade-call">{t.callH2}</h2>
      <p class="trade-call__label"><strong>Example call, not a customer.</strong> Written to show the flow; names and addresses are made up.</p>
    </div>
    <ol class="trade-call">
      {t.call.map((c) => (
        <li class:list={['trade-call__line', c.who === 'Remi' && 'trade-call__line--remi']}>
          <span class="trade-call__who">{c.who}</span>
          <span class="trade-call__text">{c.line}</span>
        </li>
      ))}
    </ol>
    <div class="prose">
      <p>{t.callNote} <a href="/hear-it">Hear a recorded example call →</a></p>
    </div>
  </section>

  <!-- EMERGENCY RULES -->
  <section class="page-section container">
    <div class="prose">
      <h2>{t.emergencyH2}</h2>
      <p>{t.emergencyIntro}</p>
      <ul>{t.emergencyRules.map((r) => <li set:html={r} />)}</ul>
      <p set:html={t.emergencyNote} />
    </div>
  </section>

  <!-- INTAKE -->
  <section class="page-section container">
    <div class="prose">
      <h2>{t.intakeH2}</h2>
      <p>{t.intakeIntro}</p>
      <ul>{t.intake.map((f) => <li><strong>{f.field}</strong>: {f.why}</li>)}</ul>
    </div>
  </section>

  <section class="page-section container">
    <h2 class="section-title" style="margin-bottom:8px">{t.booksH2}</h2>
    <div class="feature-grid">
      {ind.books.map((b) => <div class="feature-card"><h3>{b}</h3></div>)}
    </div>
  </section>

  {showVideo && (
    <section class="page-section container">
      <h2 class="section-title" style="margin-bottom:8px">Watch an example call get booked</h2>
      <p class="prose" style="margin-bottom:var(--space-3)">Remi answers an example call, qualifies the caller and books the appointment; then the operator portal the owner sees. Demo account, not a customer.</p>
      <video
        src="/assets/video/ai-receptionist.mp4"
        poster="/assets/img/operator-portal.webp"
        preload="none"
        playsinline
        muted
        loop
        controls
        width="1280"
        height="720"
        aria-label="Keres AI receptionist example call and operator portal"
        style="width:100%;max-width:720px;height:auto;border-radius:var(--radius-lg);border:1px solid var(--border)"
      ></video>
      <p class="k-mock__caption">Recording uses example data. Nothing on this page loads a video until you press play.</p>
    </section>
  )}

  <!-- INTEGRATIONS -->
  <section class="page-section container">
    <div class="prose">
      <h2>Does it book into ServiceTitan, Jobber or Housecall Pro?</h2>
      <p>{t.softwareNote}</p>
      <ul>
        <li>Live: <a href="/integrations/servicetitan">ServiceTitan</a>, <a href="/integrations/google-calendar">Google Calendar</a>, <a href="/integrations/hubspot">HubSpot</a> and <a href="/integrations/zapier">Zapier</a></li>
        <li>Rolling out, not live yet: Jobber and Housecall Pro</li>
      </ul>
    </div>
  </section>

  <!-- COST -->
  <section class="page-section container">
    <div class="prose">
      <h2>{t.costH2}</h2>
      <Fragment set:html={t.costBody} />
      <p><a href={t.calculator.href}>Open the {t.calculator.label} →</a></p>
    </div>
  </section>

  {t.priceH2 && t.priceBody && (
    <section class="page-section container">
      <div class="prose">
        <h2>{t.priceH2}</h2>
        <Fragment set:html={t.priceBody} />
      </div>
    </section>
  )}

  <!-- NEUTRAL CHECKLIST -->
  <section class="page-section container">
    <div class="prose">
      <h2>{t.compareH2}</h2>
      <p>{t.compareIntro}</p>
      <ul>{t.checklist.map((c) => <li>{c}</li>)}</ul>
      <p>Keres AI’s own answers are on <a href="/agents/inbound">Remi’s page</a> and <a href="/pricing">pricing</a>.</p>
      {guides.length > 0 && (
        <>
          <h2>Guides for {ind.shortLower} operators</h2>
          <ul>{guides.map((g) => <li><a href={`/guides/${g.slug}.html`}>{g.listTitle}</a> — {g.listDesc}</li>)}</ul>
        </>
      )}
      <p>
        Answering is one part of winning the job: <a href="/services/found">Found</a> gets you found on Google
        and <a href="/agents/follow-up">Theo</a> follows up on open estimates.
        More trades: {peers.map((p, i) => <>{i > 0 ? ' · ' : ''}<a href={`/ai-receptionist-for-${p.slug}`}>{p.short}</a></>)} ·
        <a href="/industries/home-services">all home services</a>.
      </p>
    </div>
  </section>

  <FaqSection faqs={ind.faqs} title={`AI receptionist for ${ind.shortLower}: questions`} />

  <CtaBand heading={t.ctaHeading} sub={t.ctaSub} />
</Layout>

<style>
  .trade-call__label { font-size: 0.95rem; }
  .trade-call {
    list-style: none;
    margin: var(--space-3, 1.5rem) 0;
    padding: 0;
    max-width: 720px;
    display: grid;
    gap: 10px;
  }
  .trade-call__line {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 12px;
    align-items: baseline;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
  }
  .trade-call__line--remi { border-color: var(--accent, currentColor); }
  .trade-call__who { font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .trade-call__line--remi .trade-call__who { color: var(--accent, inherit); }
  @media (max-width: 480px) {
    .trade-call__line { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
