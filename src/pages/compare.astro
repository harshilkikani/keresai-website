---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { organizationSchema, breadcrumbSchema, webPageSchema, articleSchema, VENDORS_CHECKED_ISO } from '../data/schema';
import { comparisons, ROUNDUP_SLUGS } from '../data/comparisons';

const path = '/compare';
const title = 'AI Receptionist Alternatives Compared (2026) | Keres AI';
const description = 'Smith.ai, Ruby, Goodcall, Rosie and AnsweringLegal alternatives compared: who answers, how each one bills, and the price each vendor publishes.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Compare', path }];

// Only the sourced, indexable pages are listed here. The other Keres-vs pages
// are noindex until they are rewritten as sourced roundups.
const guides = [
  { href: '/best-ai-receptionist', title: 'Best AI receptionists for small businesses (2026)', text: 'Ten AI receptionists and answering services side by side, with picks by need and by industry.' },
  { href: '/ai-receptionist-cost', title: 'How much does an AI receptionist cost?', text: 'Published 2026 prices, how each vendor bills, and what 100 calls a month cost on each plan.' },
  { href: '/best-google-business-profile-management', title: 'Best Google Business Profile management services (2026)', text: 'GBP software, done-for-you services and website bundles, with what each includes and its published price.' },
];
const roundups = ROUNDUP_SLUGS.map((s) => comparisons.find((c) => c.slug === s)!).filter(Boolean);

const webpage = webPageSchema({
  path,
  name: title,
  description,
  speakableSelectors: ['.answer-block', '.lead'],
});

// Dated: the vendor prices these comparisons quote were checked on VENDORS_CHECKED.
const article = articleSchema({
  path,
  headline: title.replace(/\s*\|\s*Keres AI$/, ''),
  description,
  datePublished: VENDORS_CHECKED_ISO,
  dateModified: VENDORS_CHECKED_ISO,
});

const ORIGIN = 'https://www.keresai.com';
const compareListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI receptionist and answering service comparisons',
  itemListElement: [
    ...guides.map((g) => ({ name: g.title, url: `${ORIGIN}${g.href}`, description: g.text })),
    ...roundups.map((c) => ({ name: `${c.competitor} alternatives, compared`, url: `${ORIGIN}/${c.slug}`, description: c.description })),
  ].map((item, i) => ({ '@type': 'ListItem', position: i + 1, ...item })),
};
---
<Layout title={title} description={description} path={path} pageType="CollectionPage">
  <Schema slot="head" graph={[article, compareListSchema, webpage, breadcrumbSchema(crumbs), organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />

  <header class="page-hero container">
    <span class="eyebrow">Comparisons</span>
    <h1>AI receptionist and answering service <span class="accent">alternatives, compared</span></h1>
    <p class="updated" style="font-size:14px;color:var(--text-dim);margin:-8px 0 16px">Updated <time datetime="2026-10-11">October 11, 2026</time></p>
    <p class="lead">Who answers, how each one bills and the price each vendor publishes, taken from the vendors’ own sites. Keres AI wrote these pages and sells one of the receptionists in them.</p>
    <div class="hero-ctas">
      <a href="/best-ai-receptionist" class="btn btn-primary">Best AI receptionists</a>
      <a href="/ai-receptionist-cost" class="btn btn-outline">AI receptionist cost</a>
    </div>
  </header>

  <section class="page-section container">
    <div class="answer-block">
      <p>Keres AI sells websites, Google Business Profile management and an AI receptionist (Remi) to local service businesses. Compared with answering services like Smith.ai and Ruby, Remi answers with AI rather than live receptionists, books the appointment during the call, and bills a monthly rate with included minutes, then per minute, with no per-call fees. The pages below show each alternative with the price it publishes.</p>
    </div>
  </section>

  <section class="page-section container">
    <div class="section-label">Start here</div>
    <h2 class="section-title" style="margin-bottom:8px">Buyer’s guides</h2>
    <div class="feature-grid">
      {guides.map((g) => (
        <a class="feature-card" href={g.href} style="text-decoration:none;display:block">
          <h3>{g.title}</h3>
          <p>{g.text}</p>
          <span class="inline-cta-link" style="margin-top:8px;display:inline-block">Read the guide →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section container">
    <div class="section-label">Alternatives by vendor</div>
    <h2 class="section-title" style="margin-bottom:8px">Replacing your answering service?</h2>
    <p class="prose" style="margin-bottom:var(--space-4)">Answering services differ on who answers (people, AI or both) and how they bill (per call, per minute or per caller). Each page lists the alternatives with their published prices, says which fits which need, and says when Keres AI is not the right choice.</p>
    <div class="feature-grid">
      {roundups.map((c) => (
        <a class="feature-card" href={`/${c.slug}`} style="text-decoration:none;display:block">
          <div class="service-cat" style="margin-bottom:4px">{c.category}</div>
          <h3>{c.competitor} alternatives</h3>
          <p>{c.description}</p>
          <span class="inline-cta-link" style="margin-top:8px;display:inline-block">See the comparison →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section container">
    <div class="prose">
      <h2>What matters when you compare</h2>
      <p>Two questions separate most options. First, who answers: a live receptionist, AI, or both on the same line. Second, how you are billed: per minute, per call or per caller, and what each extra unit costs once the plan runs out. The entry price only tells you what a quiet month costs.</p>
      <p>Then check what happens on the call: whether the appointment is booked into your calendar or CRM, how urgent calls reach you, and who sets the receptionist up. <a href="/hear-it">Hear Remi answer a call</a> or <a href="/pricing">see how Keres AI prices it</a>.</p>
    </div>
  </section>

  <CtaBand
    heading="Get Remi quoted to your call volume"
    sub="Tell us what you use now and roughly how many calls you get. We will show you Remi on a call and quote the monthly rate."
  />
</Layout>
