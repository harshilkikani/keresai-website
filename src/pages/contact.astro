---
import Layout from '../layouts/Layout.astro';
import { EMAIL } from '../data/site';
import { CONTACT_PHONE } from '../config/business';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { organizationSchema, breadcrumbSchema } from '../data/schema';

const path = '/contact';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path }];
---
<Layout
  title="Contact Keres AI: Sales and Support"
  description="Contact Keres AI about websites, Google Business Profile management or Remi, the AI receptionist. Email us or book a 30-minute call; we reply within a day."
  path={path}
  pageType="ContactPage"
  mainEntityId="https://www.keresai.com/#organization"
>
  <Schema slot="head" graph={[breadcrumbSchema(crumbs), organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />
  <div class="page-hero container">
    <span class="eyebrow">Contact</span>
    <h1>Let's <span class="accent">connect</span></h1>
    <p class="lead">Questions about Found (websites and Google Business Profile management) or Remi (Keres AI’s AI receptionist)? Send a message below, email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>{CONTACT_PHONE && <>, call <a href={CONTACT_PHONE.href} data-event="tel_click">{CONTACT_PHONE.display}</a></>}, or <a href="/quote">get a quote</a> and book a 30-minute call. We reply within 24 hours, and on the call we put Remi on the line so you can test it yourself.</p>
  </div>

  <section class="page-section container container-narrow">
    <div id="form-success" class="form-status-ok" style="display:none" tabindex="-1">
      <div class="form-status-ok-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
      <div class="form-status-ok-title">Message sent successfully!</div>
      <div class="form-status-ok-msg">We'll get back to you within 24 hours.</div>
    </div>
    <div id="form-error" class="form-status-err" style="display:none" role="alert">Something went wrong. Please try again or email us directly.</div>
    <form id="contact-form" action="https://formspree.io/f/mojywlnn" method="POST" novalidate>
      <input type="hidden" name="_subject" value="New enquiry from Keres AI website">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-5000px">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="fname">Full Name <span class="req">*</span></label>
          <input type="text" id="fname" name="name" class="form-input" required autocomplete="name" placeholder="Jane Doe">
          <div class="field-error" id="fname-err" aria-live="polite"></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="femail">Email <span class="req">*</span></label>
          <input type="email" id="femail" name="email" class="form-input" required autocomplete="email" placeholder="jane@company.com">
          <div class="field-error" id="femail-err" aria-live="polite"></div>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="fcompany">Company</label>
          <input type="text" id="fcompany" name="company" class="form-input" autocomplete="organization" placeholder="Acme Inc.">
        </div>
        <div class="form-group">
          <label class="form-label" for="findustry">Industry</label>
          <select id="findustry" name="industry" class="form-input">
            <option value="">Select your industry</option>
            <option value="real-estate">Real Estate</option>
            <option value="home-services">Home Services</option>
            <option value="med-spa">Med Spas &amp; Dental</option>
            <option value="professional">Professional Intake</option>
            <option value="other">Other</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="fmessage">Message <span class="req">*</span></label>
        <textarea id="fmessage" name="message" class="form-input" required placeholder="How can we help?"></textarea>
        <div class="field-error" id="fmessage-err" aria-live="polite"></div>
      </div>
      <button type="submit" class="btn btn-primary form-submit" id="form-btn">Send Message</button>
    </form>
  </section>

  <section class="page-section container container-narrow">
    <div class="prose">
      <h2>What should you include in a message?</h2>
      <p>The more we know, the more useful the first reply. For a quote, tell us your trade, how many locations you run, roughly how many calls you get a month, and which calendar, CRM or field-service system your team uses (Keres AI connects to Google Calendar, HubSpot, ServiceTitan and Zapier today). If you are asking about Found, include your website address and the name on your Google Business Profile. If something is not working for an existing account, say what happened, when, and the caller’s number if a call is involved.</p>
      <h2>What happens next?</h2>
      <p>We reply by email within 24 hours. For a quote, the next step is a 30-minute call: we map how calls are answered today, put Remi on the line so you can test it, and come back with a monthly rate with included minutes. Everything is month-to-month, and Keres sets it up for you. Remi answers in English.</p>
      <h2>Looking for something else?</h2>
      <ul>
        <li><a href="/quote">Get a quote</a>: five questions, then a 30-minute call with the number ready.</li>
        <li><a href="/pricing">Pricing</a>: what each worker starts at and what changes the quote.</li>
        <li><a href="/hear-it">Hear it</a>: example calls by industry.</li>
        <li><a href="/trust">Trust and security</a>: how your data is handled, and what certifications Keres AI does not hold.</li>
        <li><a href="/partners">Partners</a>: for agencies and IT providers who want to refer or resell.</li>
      </ul>
    </div>
  </section>
</Layout>
