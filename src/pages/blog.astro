---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { organizationSchema, breadcrumbSchema } from '../data/schema';

const path = '/blog';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Resources', path }];

const guides = [
  { href: '/guides/septic-automation-playbook.html', cat: 'Featured · Deep dive', title: 'The Septic Service Automation Playbook', desc: 'Where AI delivers the highest ROI for septic operators: intake triage, pumping reminders, emergency call handling, and invoice follow-up.' },
  { href: '/guides/customer-intake-automation.html', cat: 'Guide', title: 'Customer Intake Automation for Field Service', desc: 'How to automate customer intake calls and forms so no lead slips through the cracks.' },
  { href: '/guides/roofing-growth-through-ai.html', cat: 'Deep dive', title: 'Roofing Company Growth Through AI', desc: 'A practical look at how roofing companies use AI to capture and book more storm-season leads.' },
  { href: '/guides/hvac-scaling-checklist.html', cat: 'Deep dive', title: 'HVAC Business Scaling Checklist', desc: 'Seasonal automation, maintenance reminders, emergency dispatch, and billing automation for HVAC leaders.' },
  { href: '/guides/towing-operations-automation.html', cat: 'Deep dive', title: 'Towing Dispatch & Operations Automation', desc: 'Automating dispatch, intake, and follow-up for high-volume towing operations.' },
  { href: '/guides/measuring-automation-roi.html', cat: 'Best practice', title: 'Measuring the ROI of Business Automation', desc: 'A simple framework for measuring the real cost and time savings of automation.' },
  { href: '/guides/integrating-ai-into-your-stack.html', cat: 'Best practice', title: 'Integrating AI Into Your Current Stack', desc: 'How to connect AI agents to the CRM, calendar, and phone systems you already run on.' },
  { href: '/guides/roofing-case-study-15-hours.html', cat: 'Case study', title: 'Roofing Company Saves 15 Hours/Week', desc: 'A real client story: how one roofing company reclaimed 15 hours a week with automation.' },
];
---
<Layout
  title="Resources & Guides — AI Receptionist & Outbound Playbooks | Keres AI"
  description="Guides, playbooks, and case studies on AI receptionists, missed-call recovery, appointment automation, and AI outbound for service businesses."
  path={path}
>
  <Schema slot="head" graph={[
    breadcrumbSchema(crumbs),
    organizationSchema,
    { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Keres AI Resources', url: 'https://www.keresai.com/blog', isPartOf: { '@id': 'https://www.keresai.com/#website' } },
  ]} />

  <Breadcrumbs crumbs={crumbs} />
  <header class="page-hero container">
    <span class="eyebrow">Resources</span>
    <h1>Playbooks for <span class="accent">capturing every lead</span></h1>
    <p class="lead">Guides and case studies on answering every call, recovering missed-call revenue, automating appointments, and running outbound that books meetings.</p>
  </header>

  <section class="page-section container">
    <div class="feature-grid">
      {guides.map((g) => (
        <a class="feature-card" href={g.href} style="text-decoration:none; display:block;">
          <div class="plan" style="font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--orange);margin-bottom:10px">{g.cat}</div>
          <h3>{g.title}</h3>
          <p>{g.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <CtaBand heading="Ready to stop losing leads?" sub="Book a free 30-minute demo and see Keres answer and book a call live." />
</Layout>
