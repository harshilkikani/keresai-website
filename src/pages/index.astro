---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import {
  organizationSchema,
  softwareApplicationSchema,
  websiteSchema,
  faqSchema,
} from '../data/schema';

const faqs = [
  {
    q: 'What is an AI receptionist?',
    a: 'An AI receptionist is software that answers your business phone automatically, 24/7. It greets callers, answers questions, qualifies the lead, books or reschedules appointments, and sends your team a summary — so no call ever goes to voicemail and no lead is lost.',
  },
  {
    q: 'How fast does Keres AI answer a call?',
    a: 'Keres AI answers every inbound call within two rings, day or night, including weekends and holidays. It never puts a caller on hold and never sends them to voicemail.',
  },
  {
    q: 'Can the AI receptionist book appointments?',
    a: 'Yes. Keres AI books, confirms, and reschedules appointments directly on your calendar (Google Calendar, Outlook, or your field-service software) during the call, then texts the caller a confirmation.',
  },
  {
    q: 'What is an AI SDR and how does Keres outbound work?',
    a: 'An AI SDR runs your outbound sales development: it builds and sends personalized cold email sequences, manages inbox warmup and deliverability, and books interested replies straight onto your calendar — without hiring a human SDR.',
  },
  {
    q: 'How does Keres AI improve email deliverability?',
    a: 'Keres handles SPF, DKIM, and DMARC setup, inbox warmup, sending-volume ramp, and list hygiene so your outbound lands in the primary inbox instead of spam.',
  },
  {
    q: 'How quickly can I go live?',
    a: 'Most accounts are live within five business days. We map your call flows and outbound goals, connect your phone number, calendar, and CRM, then launch. Month-to-month, cancel anytime.',
  },
  {
    q: 'Do I need a technical team?',
    a: 'No. We handle setup, integrations, and tuning. You point your number at Keres and connect your calendar — we do the rest.',
  },
];
---
<Layout
  title="AI Receptionist & AI SDR Platform | Never Miss a Lead — Keres AI"
  description="Keres AI answers every call 24/7, books appointments automatically, and runs AI outbound that lands in the inbox. Capture every lead, book more meetings, cut staffing costs. Book a demo."
  path="/"
>
  <Schema slot="head" graph={[organizationSchema, softwareApplicationSchema, websiteSchema, faqSchema(faqs)]} />

  <!-- HERO -->
  <section id="hero" aria-labelledby="hero-title" class="hero-grid">
    <div class="hero-ambient" aria-hidden="true"></div>
    <div class="hero-left">
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-rule" aria-hidden="true"></span>
        <span>AI receptionist &amp; AI SDR · For businesses that live on the phone</span>
      </div>
      <h1 id="hero-title" class="hero-title">
        <span>Your phone keeps ringing.</span>
        <span class="accent">Our AI answers.</span>
      </h1>
      <p class="hero-sub">
        Keres AI is an AI receptionist and AI sales platform. We answer every inbound call in two rings, qualify and book the lead, and run outbound email that actually reaches the inbox &mdash; so you never miss revenue, day or night.
      </p>
      <div class="hero-ctas">
        <a href="/demo" class="btn btn-primary">Book a Demo</a>
        <a href="/ai-receptionist" class="hero-cta-ghost">
          <span>See how it works</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <ul class="hero-meta" aria-label="At a glance">
        <li><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Live in five business days</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Month-to-month, cancel anytime</span></li>
        <li><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Trained on your business</span></li>
      </ul>
    </div>

    <aside class="hero-anchor" aria-hidden="true">
      <div class="anchor-card">
        <header class="anchor-head">
          <div class="anchor-head-left"><span class="anchor-dot"></span><span class="anchor-status">Inbound call</span></div>
          <span class="anchor-timer">Sat 9:42 PM</span>
        </header>
        <div class="anchor-caller">
          <div class="anchor-caller-num">+1 (617) 555-0142</div>
          <div class="anchor-caller-loc">Cambridge, MA</div>
        </div>
        <div class="anchor-stream">
          <div class="anchor-line anchor-line-bot"><span class="anchor-tag">Keres</span><p>Hi, you&rsquo;ve reached the Hollowbrook team. How can I help?</p></div>
          <div class="anchor-line anchor-line-user"><span class="anchor-tag">Caller</span><p>I saw the listing at 24 Oak Hill Lane. Can I tour it this weekend?</p></div>
          <div class="anchor-line anchor-line-bot"><span class="anchor-tag">Keres</span><p>Of course. Saturday at 2 PM or Sunday at 10 AM works for the agent.</p></div>
          <div class="anchor-line anchor-line-user"><span class="anchor-tag">Caller</span><p>Sunday 10 AM is great.</p></div>
        </div>
        <footer class="anchor-foot">
          <div class="anchor-foot-left">
            <span class="anchor-check"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span>Showing booked &middot; Sunday 10:00 AM</span>
          </div>
          <span class="anchor-foot-right">&rarr; CRM</span>
        </footer>
      </div>
    </aside>
  </section>

  <!-- TRUST BAR -->
  <div class="trust" aria-label="Industries served">
    <div class="container trust-inner">
      <span class="trust-label">Trusted by teams across</span>
      <span class="trust-logo">Real Estate</span>
      <span class="trust-logo">Home Services</span>
      <span class="trust-logo">Med Spas</span>
      <span class="trust-logo">Legal Intake</span>
      <span class="trust-logo">Brokerages</span>
      <span class="trust-logo">Property Management</span>
    </div>
  </div>

  <!-- WHAT IS (direct-answer block for AI search) -->
  <section id="about" class="dark" aria-labelledby="about-title">
    <div class="container about-grid reveal">
      <div>
        <div class="section-label">What Keres does</div>
        <h2 id="about-title" class="section-title">
          <span>The AI front desk and sales team that</span>
          <span class="accent">never sleeps.</span>
        </h2>
        <p class="section-body">Keres AI is a platform for service businesses that live on the phone. Our <strong>AI receptionist</strong> answers every call, captures every lead, and books appointments around the clock. Our <strong>AI SDR</strong> runs outbound email that reaches the inbox and turns cold lists into booked meetings &mdash; without adding headcount.</p>
        <p class="section-body" style="margin-top:14px">Point your number at Keres, connect your calendar and CRM, and every missed call becomes a booked job. No voicemail, no after-hours gaps, no leads slipping through.</p>
        <div class="stats">
          <div><div class="stat-num">24/7</div><div class="stat-label">Calls answered</div></div>
          <div><div class="stat-num">2 rings</div><div class="stat-label">Average pickup</div></div>
          <div><div class="stat-num">5 days</div><div class="stat-label">Typical go-live</div></div>
        </div>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
          <div><div class="value-title">Answer every call</div><div class="value-desc">Two-ring pickup, 24/7. Nights, weekends, and overflow when your team is busy. No caller hits voicemail.</div></div>
        </div>
        <div class="value-card">
          <div class="value-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/></svg></div>
          <div><div class="value-title">Book appointments automatically</div><div class="value-desc">The AI qualifies the caller and books straight onto your calendar, then texts a confirmation.</div></div>
        </div>
        <div class="value-card">
          <div class="value-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg></div>
          <div><div class="value-title">Outbound that converts</div><div class="value-desc">The AI SDR sends personalized sequences and books replies — with deliverability built in.</div></div>
        </div>
        <div class="value-card">
          <div class="value-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20h18M5 20V10l7-5 7 5v10M9 20v-6h6v6"/></svg></div>
          <div><div class="value-title">Cut staffing overhead</div><div class="value-desc">Cover the front desk and outbound without hiring, paying for an answering service, or losing nights and weekends.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES (was Services) -->
  <section id="services" aria-labelledby="services-title">
    <div class="container reveal">
      <div class="section-label">The platform</div>
      <h2 id="services-title" class="section-title">
        <span>One platform.</span>
        <span class="accent">Every lead, handled.</span>
      </h2>
      <p class="section-body">Inbound and outbound in one place — answer every call, then turn cold lists into booked meetings.</p>

      <div class="services-grid">
        <article class="service-card">
          <div class="service-visual">
            <video class="service-video" src="/assets/video/ai-receptionist.mp4" preload="metadata" playsinline muted loop controls aria-label="AI receptionist operator portal walkthrough"></video>
          </div>
          <div class="service-body">
            <div class="service-cat">AI Receptionist</div>
            <h3 class="service-name"><a href="/ai-receptionist">Answer &amp; book every call</a></h3>
            <p class="service-desc">The AI answers, books appointments, remembers returning customers, and texts the owner instantly when something's an emergency. See the operator dashboard and live owner-alert pane.</p>
          </div>
        </article>

        <article class="service-card">
          <div class="service-visual">
            <video class="service-video" src="/assets/video/custom-agents.mp4" preload="metadata" playsinline muted loop controls aria-label="AI SDR outbound demo"></video>
          </div>
          <div class="service-body">
            <div class="service-cat">AI SDR</div>
            <h3 class="service-name"><a href="/ai-sdr">Outbound that books meetings</a></h3>
            <p class="service-desc">A real outbound agent we built for a client. Personalized sequences, automatic follow-up, and replies booked straight onto the calendar.</p>
          </div>
        </article>

        <article class="service-card service-card-placeholder">
          <div class="service-visual">
            <div class="service-placeholder">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              <span>Demo coming soon</span>
            </div>
          </div>
          <div class="service-body">
            <div class="service-cat">Deliverability</div>
            <h3 class="service-name"><a href="/email-deliverability">Land in the inbox</a></h3>
            <p class="service-desc">SPF, DKIM, DMARC, inbox warmup, and list hygiene handled for you — so outbound reaches the primary inbox instead of spam.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section id="industries" class="alt" aria-labelledby="industries-title">
    <div class="container reveal">
      <div class="section-label">Who it's for</div>
      <h2 id="industries-title" class="section-title">
        <span>Built for the</span>
        <span class="accent">businesses that live on the phone</span>
      </h2>
      <p class="section-body">Keres serves communication-heavy businesses where the next call is the next deal — from one-agent brokerages to multi-location operations.</p>

      <div class="industries-grid">
        <a class="industry-card" href="/ai-receptionist-for-real-estate">
          <div class="industry-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 21V5l9-2 9 2v16M3 21h18M9 21v-8h6v8M9 9h2M13 9h2M9 12h2M13 12h2" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg></div>
          <div class="industry-name">Real Estate</div>
          <div class="industry-desc">Agents, brokerages, leasing teams, and property managers. After-hours buyer inquiries, showing coordination, listing follow-ups, seller intake.</div>
        </a>
        <a class="industry-card" href="/ai-receptionist-for-hvac">
          <div class="industry-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 11l9-8 9 8M5 9v11h14V9M9 21v-6h6v6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg></div>
          <div class="industry-name">Home Services</div>
          <div class="industry-desc">HVAC, plumbing, roofing, septic, electrical, and towing. Intake, dispatch, scheduling, and follow-up handled around the clock.</div>
        </a>
        <a class="industry-card" href="/ai-receptionist-for-med-spas">
          <div class="industry-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v4M12 17v4M5 12H1M23 12h-4M6.34 6.34l-2.83-2.83M20.49 20.49l-2.83-2.83M6.34 17.66l-2.83 2.83M20.49 3.51l-2.83 2.83M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg></div>
          <div class="industry-name">Med Spas &amp; Dental</div>
          <div class="industry-desc">Aesthetic clinics, wellness studios, and dental practices. Booking, rescheduling, intake forms, and pre-treatment qualification.</div>
        </a>
        <a class="industry-card" href="/ai-receptionist-for-professional-intake">
          <div class="industry-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h6 M8 9h2" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg></div>
          <div class="industry-name">Professional Intake</div>
          <div class="industry-desc">Law firms, financial advisors, accountants, consultants. New-client qualification, conflict screening, and consultation booking.</div>
        </a>
      </div>
    </div>
  </section>

  <!-- INTEGRATIONS -->
  <section id="integrations" aria-labelledby="integrations-title">
    <div class="container reveal">
      <div class="section-label">Integrations</div>
      <h2 id="integrations-title" class="section-title">
        <span>Plugs into</span>
        <span class="accent">your stack</span>
      </h2>
      <p class="section-body">Keres connects to the tools your team already uses — calendars, CRMs, phone systems, and the property or field-service platforms you run the business on.</p>

      <div class="integrations-grid">
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#f22f46"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 2.7C8.6 2.7 2.7 8.6 2.7 16S8.6 29.3 16 29.3 29.3 23.4 29.3 16 23.4 2.7 16 2.7zm0 24c-5.9 0-10.7-4.8-10.7-10.7S10.1 5.3 16 5.3 26.7 10.1 26.7 16 21.9 26.7 16 26.7zm5.8-13.2a2.3 2.3 0 1 1-4.6 0 2.3 2.3 0 0 1 4.6 0zm0 5a2.3 2.3 0 1 1-4.6 0 2.3 2.3 0 0 1 4.6 0zm-5.8 0a2.3 2.3 0 1 1-4.6 0 2.3 2.3 0 0 1 4.6 0zm0-5a2.3 2.3 0 1 1-4.6 0 2.3 2.3 0 0 1 4.6 0z"/></svg></div><div class="integration-name">Twilio</div><div class="integration-tooltip">Answer calls, send SMS, and stream voice transcripts through your Twilio numbers.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#4285f4"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M6 4h20a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 6v16h20V10H6zm4-8v4M22 2v4" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round"/></svg></div><div class="integration-name">Google Calendar</div><div class="integration-tooltip">Book jobs and appointments directly on your team's Google Calendar.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#ff4f00"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 4v8m0 8v8M4 16h8m8 0h8M7.5 7.5l5.7 5.7m5.6 5.6 5.7 5.7M24.5 7.5l-5.7 5.7m-5.6 5.6L7.5 24.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><circle cx="16" cy="16" r="3.4" fill="currentColor"/></svg></div><div class="integration-name">Zapier</div><div class="integration-tooltip">Trigger 6,000+ downstream apps from any Keres event, webhook-first.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#1f7a3e"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M4 24 L11 13 L16 19 L22 9 L28 24 Z"/></svg></div><div class="integration-name">ServiceTitan</div><div class="integration-tooltip">Push jobs, calls, and customer records to your ServiceTitan tenant in real time.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#0b5cff"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M21 4v15a7 7 0 0 1-14 0v-1.5h4.5V19a2.5 2.5 0 0 0 5 0V4z"/></svg></div><div class="integration-name">Jobber</div><div class="integration-tooltip">Sync quotes, jobs, and invoices with Jobber, bi-directional.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#ff7a59"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><circle cx="16" cy="20" r="6" fill="none" stroke="currentColor" stroke-width="2.4"/><circle cx="24" cy="9" r="3" fill="currentColor"/><path d="M22 11.5 17.5 16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M16 14V6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></div><div class="integration-name">HubSpot</div><div class="integration-tooltip">Create contacts, deals, and tasks in HubSpot CRM as leads qualify.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#1d6feb"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 4 4 14v14h8v-9h8v9h8V14L16 4z"/></svg></div><div class="integration-name">Housecall Pro</div><div class="integration-tooltip">Two-way sync for customers, jobs, and payments.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#ff7a00"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M9 4h11a8 8 0 0 1 0 16h-6l8 8h-6l-8-8V4z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/></svg></div><div class="integration-name">RingCentral</div><div class="integration-tooltip">Auto-answer and intelligently route calls from your RingCentral numbers.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#0078d4"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><rect x="14" y="6" width="14" height="20" rx="1" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m14 11 7 5 7-5" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round"/><ellipse cx="8" cy="16" rx="5" ry="6" fill="none" stroke="currentColor" stroke-width="2.4"/><ellipse cx="8" cy="16" rx="1.5" ry="2.2" fill="currentColor"/></svg></div><div class="integration-name">Outlook</div><div class="integration-tooltip">Two-way sync with Outlook / Microsoft 365 calendars.</div></div>
        <div class="integration-tile" tabindex="0"><div class="integration-logo" style="background:#6d00cc"><svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><rect x="4" y="6" width="4" height="20"/><rect x="10" y="6" width="4" height="20"/><rect x="16" y="6" width="4" height="20"/><rect x="22" y="6" width="4" height="20"/></svg></div><div class="integration-name">Make</div><div class="integration-tooltip">Wire Keres into Make (Integromat) scenarios as a trigger or action.</div></div>
      </div>
      <p class="integrations-foot">Don't see your stack? Keres speaks generic webhooks + CSV out of the box — most one-off integrations go live during onboarding.</p>
    </div>
  </section>

  <!-- ROI CALCULATOR -->
  <section id="roi" class="alt" aria-labelledby="roi-title">
    <div class="container container-narrow reveal">
      <div class="section-label">Missed-call calculator</div>
      <h2 id="roi-title" class="section-title">
        <span>What are missed calls</span>
        <span class="accent">costing you?</span>
      </h2>
      <p class="section-body">Four inputs. Transparent math. <a href="/missed-call-calculator">Open the full calculator &rarr;</a></p>

      <div class="roi-shell" data-vertical="home-services">
        <div class="roi-vert-row">
          <button type="button" class="roi-vert-btn" data-vert="real-estate">Real Estate</button>
          <button type="button" class="roi-vert-btn active" data-vert="home-services">Home Services</button>
          <button type="button" class="roi-vert-btn" data-vert="med-spa">Med Spa</button>
          <button type="button" class="roi-vert-btn" data-vert="professional">Professional</button>
        </div>
        <div class="roi-grid">
          <div class="roi-inputs">
            <label class="roi-field"><span class="roi-field-label">Monthly leads</span><input type="number" id="roi-leads" min="0" value="250"></label>
            <label class="roi-field"><span class="roi-field-label">Answer rate %</span><input type="number" id="roi-answer" min="0" max="100" value="60"></label>
            <label class="roi-field"><span class="roi-field-label">Avg ticket value</span><div class="roi-field-prefix"><span>$</span><input type="number" id="roi-job" min="0" value="680"></div></label>
            <label class="roi-field"><span class="roi-field-label">After-hours lead %</span><input type="number" id="roi-afterhours" min="0" max="100" value="35"></label>
          </div>
          <div class="roi-output">
            <div class="roi-headline-label">You're losing</div>
            <div class="roi-headline-value"><span id="roi-lost-mo">$0</span><span class="roi-per">/mo</span></div>
            <div class="roi-headline-year">≈ <span id="roi-lost-yr">$0</span> / year</div>
            <div class="roi-math">
              <div class="roi-math-row"><span>Missed leads / mo</span><span id="roi-missed">0</span></div>
              <div class="roi-math-row muted"><span id="roi-missed-calc">= 250 × (100% − 60%)</span><span></span></div>
              <div class="roi-math-row"><span>Would-have-closed jobs</span><span id="roi-jobs">0</span></div>
              <div class="roi-math-row muted"><span id="roi-close-calc">= missed × 25% close rate</span><span></span></div>
              <div class="roi-math-row"><span>Lost revenue</span><span id="roi-lost-mo-2">$0</span></div>
              <div class="roi-math-row muted"><span id="roi-job-calc">= jobs × $680 avg ticket</span><span></span></div>
              <div class="roi-math-row"><span>After-hours leads / mo</span><span id="roi-ah">0</span></div>
              <div class="roi-math-row muted"><span>- the ones most at risk</span><span></span></div>
            </div>
            <a id="roi-cta" class="btn btn-primary" href="/demo">Book a demo with these numbers →</a>
            <div class="roi-note" id="roi-note">Close rate (25%) is the typical answered-lead close rate for home services. Swap in your own number if you track it.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" aria-labelledby="process-title">
    <div class="container reveal">
      <div class="section-label">How it works</div>
      <h2 id="process-title" class="section-title">
        <span>Live in days,</span><br>
        <span class="accent">not months.</span>
      </h2>
      <p class="section-body">A repeatable, transparent onboarding — you always know what's happening next.</p>
      <div class="steps">
        <div class="step"><div class="step-title">Discovery</div><p class="step-desc">A short call to map your call flows, calendar, and outbound goals.</p></div>
        <div class="step"><div class="step-title">Connect</div><p class="step-desc">We point your number at Keres and connect your calendar, CRM, and phone system.</p></div>
        <div class="step"><div class="step-title">Train &amp; test</div><p class="step-desc">We train the AI on your business and test against real call and email scenarios.</p></div>
        <div class="step"><div class="step-title">Go live</div><p class="step-desc">Keres answers and books from day one. We monitor, tune, and report on results.</p></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" aria-labelledby="faq-title">
    <div class="container container-narrow reveal">
      <div class="section-label">FAQ</div>
      <h2 id="faq-title" class="section-title">Common questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary class="faq-q">{f.q}</summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" aria-labelledby="contact-title">
    <div class="contact-bg" aria-hidden="true"></div>
    <div class="container contact-inner reveal">
      <div class="section-label">Contact</div>
      <h2 id="contact-title" class="section-title">Let's connect</h2>
      <p class="section-body">Have a question, or want to see Keres answer a live call? We're here.</p>
      <div class="contact-grid">
        <div>
          <div class="contact-col-title">Send a message</div>
          <div class="contact-col-sub">We respond within 24 hours.</div>
          <div id="form-success" class="form-status-ok" style="display:none" tabindex="-1">
            <div class="form-status-ok-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
            <div class="form-status-ok-title">Message sent successfully!</div>
            <div class="form-status-ok-msg">We'll get back to you within 24 hours.</div>
          </div>
          <div id="form-error" class="form-status-err" style="display:none" role="alert">Something went wrong. Please try again or email us directly.</div>
          <form id="contact-form" action="https://formspree.io/f/mojywlnn" method="POST" novalidate>
            <input type="hidden" name="_subject" value="New enquiry from Keres AI website">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-5000px">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="fname">Full Name <span class="req">*</span></label>
                <input type="text" id="fname" name="name" class="form-input" required autocomplete="name" placeholder="Jane Doe">
                <div class="field-error" id="fname-err" aria-live="polite"></div>
              </div>
              <div class="form-group">
                <label class="form-label" for="femail">Email <span class="req">*</span></label>
                <input type="email" id="femail" name="email" class="form-input" required autocomplete="email" placeholder="jane@company.com">
                <div class="field-error" id="femail-err" aria-live="polite"></div>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="fcompany">Company</label>
                <input type="text" id="fcompany" name="company" class="form-input" autocomplete="organization" placeholder="Acme Inc.">
              </div>
              <div class="form-group">
                <label class="form-label" for="findustry">Industry</label>
                <select id="findustry" name="industry" class="form-input">
                  <option value="">Select your industry</option>
                  <option value="real-estate">Real Estate</option>
                  <option value="home-services">Home Services</option>
                  <option value="med-spa">Med Spas &amp; Dental</option>
                  <option value="professional">Professional Intake</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" for="fmessage">Message <span class="req">*</span></label>
              <textarea id="fmessage" name="message" class="form-input" required placeholder="Tell us about your call volume and goals..."></textarea>
              <div class="field-error" id="fmessage-err" aria-live="polite"></div>
            </div>
            <button type="submit" class="btn btn-primary form-submit" id="form-btn">Send Message</button>
          </form>
        </div>
        <div>
          <div class="contact-col-title">Book a demo</div>
          <div class="contact-col-sub">Schedule a free 30-minute walkthrough.</div>
          <div class="cal-wrapper">
            <div class="cal-header">
              <button class="cal-nav" id="calPrev" type="button" aria-label="Previous month"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <span class="cal-month" id="calMonth" aria-live="polite">April 2026</span>
              <button class="cal-nav" id="calNext" type="button" aria-label="Next month"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="cal-grid">
              <div class="cal-weekdays" id="calWeekdays" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
              <div class="cal-days" id="calDays" role="grid" aria-label="Select a date"></div>
            </div>
            <div class="cal-info" id="calInfo">Select a date to open booking.</div>
          </div>
          <p style="font-size:12.5px;color:var(--text-dim);margin-top:14px;line-height:1.6">Click a date to open our Calendly booking page and pick a time that works for you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band" aria-labelledby="cta-title">
    <div class="container cta-band-inner reveal">
      <h2 id="cta-title">Stop losing leads to voicemail.</h2>
      <p>Book a free 30-minute demo. See Keres answer a live call and book an appointment in under sixty seconds.</p>
      <a href="/demo" class="btn btn-primary">Book a Demo</a>
    </div>
  </section>

  <script slot="scripts" src="/assets/roi.js?v=3" is:inline></script>
</Layout>
