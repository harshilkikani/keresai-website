---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { organizationSchema, breadcrumbSchema, faqSchema } from '../data/schema';
import { business, CONTACT_PHONE } from '../config/business';
import { integrations, isLive, liveIntegrationNames } from '../data/integrations';

const path = '/about';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path }];
const email = business.contactEmail;
const listed = (xs: string[]) => xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

// Live first, then rolling out; both straight from src/data/integrations.ts,
// the list the /integrations pages are built from.
const integrationRows = [...integrations].sort((a, b) => Number(isLive(b)) - Number(isLive(a)));
const liveBooking = liveIntegrationNames.filter((n) => n !== 'Zapier');

// Every question heading on this page with the paragraph (or list) under it.
// The page renders from this array and the FAQPage node is built from it, so
// the structured data is the visible text, word for word.
const sell = {
  q: 'What does Keres AI sell?',
  a: 'AI workers that each do one job for a local business. Found builds and runs the website, Google Business Profile, reviews and listings, from $249 a month ($499 for law firms). Remi, the AI receptionist, answers every call in two rings, 24/7, and books the appointment; it is quoted to your call volume as one monthly rate with included minutes, then per minute. Theo, June and Sol, and custom workers, are quoted.',
};
const faqs = [
  sell,
  {
    q: 'Who is Keres AI for?',
    a: 'Keres AI is for local businesses whose sales team is whoever picks up the phone: <a href="/industries/home-services">HVAC, plumbing, roofing and other home service contractors</a>, <a href="/industries/law-firms">law firms</a>, <a href="/industries/dental-med-spa">dental practices and med spas</a>, and <a href="/industries/real-estate">real estate agents and teams</a>. Keres AI is built for owner-operated businesses with a small office. In those businesses, the same people answer the phone and do the work. For example, an HVAC contractor on a roof cannot take a no-heat call. A solo attorney in court cannot take a new-client call either. Remi answers every one of the missed calls in two rings, 24/7, runs the intake script for the trade and books into Google Calendar, HubSpot or ServiceTitan. Found, from $249 a month, suits the same businesses when customers cannot find them on Google. Keres AI is based in Houston, Texas, and works with local service businesses in every state.',
  },
  {
    q: 'Why does Keres AI exist?',
    a: 'Keres AI exists because most local service businesses cannot staff a phone around the clock. According to the U.S. Bureau of Labor Statistics, the national median wage for receptionists and information clerks was $38,010 a year in May 2025 (<a href="https://www.bls.gov/oes/current/oes434171.htm" rel="noopener" target="_blank">BLS OEWS 43-4171</a>). The BLS figure is before payroll taxes and benefits, and covers roughly 40 of the week’s 168 hours. Keres AI estimates that service businesses miss 25–40% of inbound calls, and most callers who reach voicemail do not call back (<a href="/missed-call-statistics">how we got there</a>). The leads are there; the capacity to answer the calls often isn’t. Found makes sure the business is easy to find on Google. Remi makes sure the next call is answered in two rings and booked, including nights and weekends. Finally, Theo, June and Sol keep working the same customers after the first call, with reminders, review requests and follow-up.',
  },
  {
    q: 'How does Keres AI work with a new client?',
    a: 'Keres AI works with a new client in four steps. First, a 30-minute call covers how your calls and intake run today: who answers, what gets asked and where leads stop. Second, you get a quote: Found from $249 a month ($499 for law firms), and Remi as one monthly rate with included minutes, then per minute. Third, Keres AI does the setup. For example, we write Remi’s script from your services, hours and handoff rules, then connect your number and your calendar or CRM, such as Google Calendar, HubSpot or ServiceTitan. The timing depends on your call flows and integrations, and we agree on the timing during the first call. Finally, you test Remi yourself before Remi answers a single customer. Every plan is month-to-month with 30 days’ written notice, and the office line, (973) 495-2223, is answered by a person.',
  },
  {
    q: 'What does Keres AI connect to?',
    a: `Today Remi books into ${listed(liveBooking)}, and reaches other tools through Zapier. The other integrations in the table below are rolling out and are not live yet; each page says so. See <a href="/integrations">integrations</a>.`,
  },
  {
    q: 'What doesn’t Keres AI do?',
    a: '<ul><li>Keres AI does not run Google Ads or sell traffic. Found sets up and answers Local Services Ads instead.</li><li>Remi is an AI receptionist, not a lawyer or clinician. Remi does not give legal, medical or financial advice, and does not clear a legal conflict itself; Remi collects the names so the firm can run the check.</li><li>Keres AI is not SOC 2 or HIPAA certified and does not sign BAAs or DPAs (<a href="/trust">trust and security</a>). A practice with HIPAA obligations should raise them before signing up.</li><li>Keres AI does not train third-party AI models on client data.</li><li>Remi answers in English only, as of October 2026.</li><li>Keres AI does not publish a price for Remi. Remi is quoted to call volume, with included minutes and no per-call fees.</li><li>Keres AI does not use long-term contracts. Every plan is month-to-month with 30 days’ written notice.</li></ul>',
  },
  {
    q: 'How does Keres AI check what it publishes?',
    a: 'Pages are drafted with AI assistance and reviewed by the Keres AI team. Competitor prices come from each vendor’s own pricing page and carry the date they were checked, and estimates are labelled as Keres AI estimates. Keres AI sells Remi and Found, so its comparisons say so. The <a href="/editorial-policy">editorial policy</a> covers how pages are checked and corrected.',
  },
  {
    q: 'Is Keres AI related to Keras, Kore.ai or keres.ai?',
    a: 'No. Keres AI (keresai.com) is not affiliated with keres.ai, the Keras deep-learning library or Kore.ai.',
  },
  {
    q: 'Where is Keres AI based?',
    a: 'Keres AI is based in Houston, Texas, and works with local service businesses across the United States.',
  },
  {
    q: 'How do I contact Keres AI?',
    a: `Email <a href="mailto:${email}">${email}</a>${CONTACT_PHONE ? `, call the office at <a href="${CONTACT_PHONE.href}">${CONTACT_PHONE.display}</a> (a person answers)` : ''}, or <a href="/quote">get a quote</a> and book a 30-minute call.`,
  },
];
const [, ...rest] = faqs;
const connectIdx = rest.findIndex((f) => f.q === 'What does Keres AI connect to?');
const before = rest.slice(0, connectIdx + 1);
const after = rest.slice(connectIdx + 1);
const isList = (a: string) => a.startsWith('<ul>');
---
<Layout
  title="About Keres AI: Websites & AI Receptionist"
  description="Keres AI builds and runs websites and Google Business Profiles for local service businesses, and answers their calls with Remi, an AI receptionist."
  path={path}
  pageType="AboutPage"
  mainEntityId="https://www.keresai.com/#organization"
>
  <Schema slot="head" graph={[
    breadcrumbSchema(crumbs),
    faqSchema(faqs),
    organizationSchema,
  ]} />

  <Breadcrumbs crumbs={crumbs} />
  <div class="page-hero container">
    <span class="eyebrow">About</span>
    <h1>About <span class="accent">Keres AI</span></h1>
    <p class="lead answer-block">Keres AI is a Houston, Texas company that sells done-for-you growth services to local service businesses across the United States. Found builds and runs a business’s website, Google Business Profile, reviews and listings from $249 a month ($499 for law firms), with no build fee at the base tier. Remi, the Keres AI receptionist, answers every call in two rings, 24/7, in English, and books the appointment into Google Calendar, HubSpot or ServiceTitan during the call. Additionally, Theo handles confirmations, reminders and estimate follow-up. June brings past customers back and asks for reviews, and Sol runs outbound email. For example, a plumbing company can hire Found to be found on Google and Remi to answer the calls Found brings in. Every worker is month-to-month, and Keres AI does all of the setup after a 30-minute call.</p>
    <div class="hero-ctas"><a href="/quote" class="btn btn-primary">Get a quote</a></div>
  </div>

  <section class="page-section container">
    <div class="prose">
      <h2>{sell.q}</h2>
      <p set:html={sell.a} />
      <div class="compare-wrap">
        <table class="compare-table">
          <thead><tr><th>Worker</th><th>Job</th><th>Price</th></tr></thead>
          <tbody>
            <tr><td><a href="/services/found">Found</a></td><td>Website, Google Business Profile, reviews and listings</td><td>From $249/month ($499 for law firms)</td></tr>
            <tr><td><a href="/agents/inbound">Remi</a></td><td>AI receptionist: answers every call in two rings and books it</td><td>Quoted to call volume; included minutes, then per minute; no per-call fees</td></tr>
            <tr><td><a href="/agents/follow-up">Theo</a></td><td>Confirmations, reminders and estimate follow-up</td><td>Quoted</td></tr>
            <tr><td><a href="/agents/reactivation">June</a></td><td>Brings past customers back and asks every customer for a review</td><td>Quoted</td></tr>
            <tr><td><a href="/agents/outbound">Sol</a></td><td>Outbound email with deliverability set up first</td><td>Quoted</td></tr>
            <tr><td><a href="/custom">Custom</a></td><td>A worker built for one recurring job in your business</td><td>Quoted: fixed build price and a monthly run fee</td></tr>
          </tbody>
        </table>
      </div>
      <p>Billing is monthly, and the <a href="/legal/terms.html">terms</a> ask for 30 days’ written notice to cancel. See <a href="/pricing">pricing</a> for what changes a quote.</p>

      {before.map((f) => (
        <>
          <h2>{f.q}</h2>
          {isList(f.a) ? <Fragment set:html={f.a} /> : <p set:html={f.a} />}
        </>
      ))}

      <div class="compare-wrap">
        <table class="compare-table">
          <caption class="visually-hidden">Keres AI integrations: live and rolling out</caption>
          <thead><tr><th>Integration</th><th>Category</th><th>Status</th></tr></thead>
          <tbody>
            {integrationRows.map((i) => (
              <tr>
                <td>{isLive(i) ? <a href={`/integrations/${i.slug}`}>{i.name}</a> : i.name}</td>
                <td>{i.category}</td>
                <td>{isLive(i) ? 'Live' : 'Rolling out, not live yet'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {after.map((f) => (
        <>
          <h2>{f.q}</h2>
          {isList(f.a) ? <Fragment set:html={f.a} /> : <p set:html={f.a} />}
        </>
      ))}
    </div>
  </section>

  <CtaBand heading="See what Keres can do for your business" sub="Book a 30-minute call and hear Remi answer and book a call live." />
</Layout>
