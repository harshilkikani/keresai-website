---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { organizationSchema, breadcrumbSchema } from '../data/schema';

const path = '/about';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path }];
---
<Layout
  title="About Keres AI — The AI Receptionist & AI SDR Platform"
  description="Keres AI builds the AI receptionist and AI SDR platform for businesses that live on the phone — answering every call and booking every appointment."
  path={path}
>
  <Schema slot="head" graph={[breadcrumbSchema(crumbs), organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />
  <header class="page-hero container">
    <span class="eyebrow">About</span>
    <h1>We build the front desk and sales team that <span class="accent">never sleeps</span></h1>
    <p class="lead">Keres AI is a platform for service businesses that live on the phone. We answer every call, book every appointment, and run outbound that reaches the inbox — so growing teams stop losing revenue to missed calls and slow follow-up.</p>
    <div class="hero-ctas"><a href="/demo" class="btn btn-primary">Book a Demo</a></div>
  </header>

  <section class="page-section container">
    <div class="prose">
      <h2>Why we exist</h2>
      <p>Service businesses lose 25–40% of inbound calls — and most callers who hit voicemail never call back. The leads are there; the capacity to answer them isn’t. Hiring more front-desk staff is expensive, and traditional answering services just take messages. We built Keres so every call gets answered and every lead gets booked, automatically.</p>
      <h2>What we do</h2>
      <p>Our <a href="/ai-receptionist">AI receptionist</a> answers inbound calls in two rings, 24/7, qualifies the caller, and books the appointment. Our <a href="/ai-sdr">AI SDR</a> runs personalized outbound email with <a href="/email-deliverability">deliverability</a> built in, and books qualified meetings on your calendar. One platform for every lead — inbound and outbound.</p>
      <h2>How we work</h2>
      <p>We’re done-for-you. We map your call flows and outbound goals, connect your number, calendar, and CRM, train the AI on your business, and launch — usually within five business days. Month-to-month, cancel anytime. Your data is never used to train third-party models; we sign DPAs and support SOC 2-aligned and HIPAA-aware workflows.</p>
    </div>
  </section>

  <CtaBand heading="See what Keres can do for your business" sub="Book a free 30-minute demo and watch the platform answer and book a call live." />
</Layout>
