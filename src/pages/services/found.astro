---
import { business, has } from '../../config/business';
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import Testimonial from '../../components/Testimonial.astro';
import DailyBrief from '../../components/DailyBrief.astro';
import { organizationSchema, breadcrumbSchema, faqSchema, workerService } from '../../data/schema';
import { foundServices, plans, PHONE } from '../../data/site';

const path = '/services/found';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Found', path },
];
const found = plans.find((p) => p.slug === 'found')!;

const faqs = [
  {
    q: 'What kinds of businesses is Found for?',
    a: 'Local service businesses that win work from Google and the phone: HVAC, plumbing, roofing, electrical, landscaping and cleaning companies, plus real estate agents, law firms, and dental and med-spa practices. The site template is built for your trade, so the service pages, calls to action and booking flow match how your customers buy.',
  },
  {
    q: 'How is Found different from hiring a marketing agency?',
    a: 'Found is a fixed scope at a published monthly price: the website, the Google Business Profile, review requests and listings, month-to-month with no build fee at the base tier. We do not run Google Ads or sell traffic; we set up and answer Local Services Ads because Remi answers in two rings.',
  },
  {
    q: 'Do I have to buy the AI receptionist to get Found?',
    a: 'No. Found is sold on its own, and you can keep answering your own calls. Remi, Keres AI’s AI receptionist, is a separate worker quoted to your call volume; the site’s click-to-call and booking widget are built to hand calls to Remi if you add it later.',
  },
  {
    q: 'Is there a contract?',
    a: 'No long-term contract. Found is month-to-month like every other plan, with 30 days’ written notice to cancel, and there is no build fee at the base tier: design, hosting and the care plan are all inside the monthly price.',
  },
  {
    q: 'Who owns the website?',
    a: 'You do. The domain stays in your name, the content is yours, and if you leave we hand over an export rather than holding the site hostage. That is the difference between a care plan and a lease.',
  },
  {
    q: 'Can I keep my current website?',
    a: 'Yes. You can take Google Business Profile management, reviews and listings and leave your existing site alone. The price comes down when we are not building and hosting a site for you.',
  },
  {
    q: 'How much does Found cost?',
    a: 'From $249/month, or from $499/month for law firms — legal is more competitive, the listings ecosystem is different, and the review compliance rules are stricter. The quote depends on how many locations you run and whether you add AI search visibility or Local Services Ads.',
  },
  {
    q: 'How long until it shows results?',
    a: 'There is no fixed timeline. Google reviews profile edits before they appear, and listings and citations take a full update cycle to spread across directories, so Keres AI reports what changed each month instead of promising a date. Review requests start the week we switch on the request flow; how many reviews arrive depends on your job volume.',
  },
  {
    q: 'Do you run Google Ads too?',
    a: 'No. We set up and answer Local Services Ads, because Google ranks those on how fast you answer and Remi answers in two rings. Paid search management is a partner referral — we will introduce you, and we do not take a cut.',
  },
];

// One Found service (the @id the Organization's offer catalog references),
// with the eight jobs as its catalog.
const serviceNodes = [{
  ...workerService('found'),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'What Found includes',
    itemListElement: foundServices.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.desc } })),
  },
}];
---
<Layout
  title="Contractor Websites & Google Profile, $249/mo | Keres AI"
  description="Done-for-you website, Google Business Profile and reviews for HVAC, plumbing, roofing and other local service businesses. From $249/month, month-to-month."
  path={path}
>
  <Schema slot="head" graph={[organizationSchema, breadcrumbSchema(crumbs), faqSchema(faqs), ...serviceNodes]} />

  <Breadcrumbs crumbs={crumbs} />

  <Section spacing="standard" labelledby="found-title">
    <div class="k-grid">
      <div class="k-col-7">
        <Eyebrow>Found &mdash; be found, then be answered</Eyebrow>
        <h1 id="found-title" class="k-display">Websites and Google Business Profile management for local businesses</h1>
        <p class="k-lede">
          Found by Keres AI is a done-for-you website and Google Business Profile service for contractors
          and other local service businesses. Found builds and runs your website, works your Google Business
          Profile every week, sends the same review request to every customer after each job and keeps your
          listings consistent. Found starts at {found.from.replace('from ', '')} a month, and law firms pay from $499.
          There is no build fee at the base tier, and every plan is month-to-month with 30 days&rsquo; written
          notice to cancel. For example, an HVAC company gets five to eight pages built for the trade, weekly
          Google posts and one name, address and phone on Apple, Bing, Yelp, Nextdoor and Angi. All of the work
          is wired to Remi, the Keres AI receptionist, who answers the calls the site and profile generate.
          Keres AI is based in Houston, Texas, and sets everything up for you.
        </p>
        <div class="price-hero-ctas">
          {PHONE && <Button href={PHONE.href} variant="primary" event="tel_click">Call {PHONE.display}</Button>}
          <Button href="/quote" variant={PHONE ? 'ghost' : 'primary'} event="demo_click">Get your quote</Button>
        </div>
      </div>
      <div class="k-col-5">
        <div class="price-facts">
          <div class="price-fact">
            <span class="price-fact__k">From</span>
            <span class="price-fact__v" data-figure>$249/month</span>
          </div>
          <div class="price-fact">
            <span class="price-fact__k">Law firms</span>
            <span class="price-fact__v" data-figure>from $499/month</span>
          </div>
          <div class="price-fact">
            <span class="price-fact__k">Build fee</span>
            <span class="price-fact__v">None at the base tier.</span>
          </div>
          <div class="price-fact">
            <span class="price-fact__k">Contract</span>
            <span class="price-fact__v">Month-to-month; 30 days&rsquo; notice to cancel.</span>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section spacing="standard" labelledby="for-title">
    <div class="k-band">
      <div class="k-band__head">
        <Eyebrow>Who it&rsquo;s for</Eyebrow>
        <h2 id="for-title" class="k-h2">Who is Found for?</h2>
        <p class="k-lede k-measure answer-block">
          Found by Keres AI is a done-for-you website, Google Business Profile and review service.
          Found serves local service businesses from $249 a month ($499 for law firms).
        </p>
      </div>
      <ul class="k-svc">
        <li class="k-svc__item"><div class="k-svc__head"><h3 class="k-svc__name">HVAC, plumbing &amp; electrical</h3></div><p class="k-svc__desc">For HVAC, plumbing and electrical contractors, Found builds a service page for each job type and area. Found also adds click-to-call emergency buttons and keeps the Google Business Profile current through peak season.</p></li>
        <li class="k-svc__item"><div class="k-svc__head"><h3 class="k-svc__name">Roofing &amp; exteriors</h3></div><p class="k-svc__desc">For roofing and exterior contractors, Found puts inspection and estimate requests first. Found posts storm-season updates to your Google profile and sends a review request after every finished job.</p></li>
        <li class="k-svc__item"><div class="k-svc__head"><h3 class="k-svc__name">Landscaping, cleaning &amp; other home services</h3></div><p class="k-svc__desc">For landscaping and cleaning companies, Found builds a mobile site with click-to-call and a quote form. Photos of your real work go on your Google Business Profile.</p></li>
        <li class="k-svc__item"><div class="k-svc__head"><h3 class="k-svc__name">Real estate, law firms, dental &amp; med spas</h3></div><p class="k-svc__desc">For agents, law firms, dental practices and med spas, Found starts with profile, reviews and listings. Remi can book consultations or showings if you add Remi.</p></li>
      </ul>
      <p class="k-body" style="margin-top:18px">What profile management involves and costs: <a href="/google-business-profile-management">Google Business Profile management</a>. How Found compares with GBP software and other services: <a href="/best-google-business-profile-management">best Google Business Profile management services</a>. See it by industry: <a href="/industries/home-services">home services</a> · <a href="/industries/real-estate">real estate</a> · <a href="/industries/law-firms">law firms</a> · <a href="/industries/dental-med-spa">dental &amp; med spas</a>.</p>
    </div>
  </Section>

  <Section tone="raised" spacing="major" labelledby="whats-in-title">
    <div class="k-band">
      <div class="k-band__head">
        <Eyebrow>What&rsquo;s in it</Eyebrow>
        <h2 id="whats-in-title" class="k-h2">What’s included in Found?</h2>
        <p class="k-lede k-measure">
          Found is everything that has to be true before your phone can ring: a site that
          converts, a profile that ranks, reviews that keep arriving, listings that agree with
          each other, and content written to be quoted by AI search. Two of the eight are
          add-ons, and they are marked.
        </p>

      </div>
      <ul class="k-svc">
        {foundServices.map((s) => (
          <li class="k-svc__item" id={s.name.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}>
            <div class="k-svc__head">
              <h3 class="k-svc__name">{s.name}</h3>
              {s.addOn && <span class="k-svc__plan k-svc__plan--addon">Add-on</span>}
            </div>
            <p class="k-svc__desc">{s.desc}</p>
          </li>
        ))}
      </ul>
      <div class="k-band__head" style="margin-top:28px;margin-bottom:0">
        <h3 class="k-h3">What does Found include each month?</h3>
        <p class="k-body k-measure">
          Found is a monthly service, and each month Found by Keres AI does the same core jobs. First,
          Found hosts and maintains a website of five to eight pages built for your trade, with updates,
          backups, security and speed monitoring under the care plan. Second, on your Google Business
          Profile, Found publishes weekly posts and photos, drafts a reply to every review for your
          approval, reports spam listings to Google and tracks searches, calls and direction requests.
          Third, every customer gets the same review request after each job. For example, a reply that
          mentions a problem is also sent to you. Found also keeps your name, address and phone the same
          on Apple, Bing, Yelp, Nextdoor and Angi, plus Avvo and FindLaw for law firms. Finally, a
          tracking number per channel shows which source produced each booked appointment. One fee
          covers all of the work, from $249 a month.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="inverse" spacing="standard" labelledby="price-title">
    <div class="k-found">
      <div class="k-found__copy">
        <Eyebrow>Pricing</Eyebrow>
        <h2 id="price-title" class="k-h2">How much does Found cost?</h2>
        <p class="k-lede">
          Found costs from $249 a month, or from $499 a month for law firms. The price is one flat
          monthly fee. The fee covers design, hosting, the care plan, your Google Business Profile,
          reviews and listings. There is no build fee at the base tier. Found is month-to-month: cancel
          with 30 days&rsquo; written notice. Three things move the number: how many locations you run,
          whether you need the site built or just cared for, and whether you add AI search visibility
          or Local Services Ads. For example, a business that keeps its current website and takes only
          profile, review and listing work pays less. Keres AI is not building or hosting a site in
          that case. Law firms start at $499 because legal search is more competitive and the review
          rules are stricter.
        </p>
        <div class="k-found__foot">
          <p class="k-found__price">
            <span class="k-found__from" data-figure>from $249</span>
            <span class="k-found__per">/month &middot; quoted to your volume</span>
          </p>
          <Button href="/quote" variant="primary" event="demo_click">Get your quote</Button>
          {PHONE && <Button href={PHONE.href} variant="ghost" event="tel_click">Or call {PHONE.display}</Button>}
        </div>
      </div>
      <div class="k-found__mock">
        <figure class="k-shot">
          <picture>
            <source srcset="/assets/img/operator-portal.webp" type="image/webp" />
            <img
              src="/assets/img/operator-portal.jpg"
              width="1280" height="720" loading="lazy" decoding="async"
              alt="The Keres console: a caller conversation on the left, answered calls and follow-ups on the right, and this month's enquiries, active jobs and bookings along the bottom."
            />
          </picture>
          <figcaption class="k-mock__caption">
            Every Found account gets the same console and the same Daily Brief. Screenshot uses example data.
          </figcaption>
        </figure>
      </div>
    </div>
  </Section>

  <Section spacing="major" labelledby="why-title">
    <div class="k-band">
      <div class="k-band__head">
        <Eyebrow>Why us and not an agency</Eyebrow>
        <h2 id="why-title" class="k-h2">How is Found different from a marketing agency?</h2>
        <p class="k-lede k-measure">
          Found is a fixed scope at a published monthly price, not an hourly retainer. Found by
          Keres AI covers the website, the Google Business Profile, review requests and listings
          from $249 a month and reports bookings by source rather than sessions. Keres AI does not
          run Google Ads or sell traffic.
        </p>
      </div>
      <ol class="k-steps">
        <li class="k-step">
          <span class="k-step__n" data-figure>01</span>
          <h3 class="k-step__title">Traffic isn&rsquo;t the deliverable</h3>
          <p class="k-step__text">An agency reports sessions and impressions. Meanwhile, the call from a search still rang out at 6pm. Found and Remi are sold together because visibility nobody answers is a cost, not a channel.</p>
        </li>
        <li class="k-step">
          <span class="k-step__n" data-figure>02</span>
          <h3 class="k-step__title">Fixed scope, so the price doesn&rsquo;t drift</h3>
          <p class="k-step__text">Every Found item has a defined scope and a flat monthly fee. No hourly overage, no "additional strategy" line, and no annual re-negotiation you have to brace for.</p>
        </li>
        <li class="k-step">
          <span class="k-step__n" data-figure>03</span>
          <h3 class="k-step__title">Your brief says which source produced the booking</h3>
          <p class="k-step__text">Call tracking runs a number per channel. For example, the morning text can tell you four of six bookings came from your Google Business Profile. No other report settles the argument.</p>
        </li>
      </ol>
    </div>
  </Section>

  {has.testimonials && (
    <Section tone="raised" spacing="standard" labelledby="proof-title">
      <div class="k-split k-split--top">
        <div class="k-split__aside">
          <Eyebrow>Proof</Eyebrow>
          <h2 id="proof-title" class="k-h2">In their words.</h2>
          <p class="k-lede">
            No invented numbers and no stock-photo customers. This slot stays visible until a
            real firm says a real thing on the record.
          </p>
        </div>
        <div class="k-split__mock">
          {business.testimonials.map((t) => <Testimonial {...t} />)}
        </div>
      </div>
    </Section>
  )}

  <Section spacing="standard" labelledby="brief-title">
    <div class="k-split k-split--reverse">
      <div class="k-split__aside">
        <Eyebrow>Owner Daily Brief</Eyebrow>
        <h2 id="brief-title" class="k-h2">You don&rsquo;t log into a dashboard.</h2>
        <p class="k-lede">
          Found reports arrive the way everything else does: one text each morning, with the
          source line telling you where the bookings actually came from.
        </p>
      </div>
      <div class="k-split__mock">
        <DailyBrief vertical="default" />
      </div>
    </div>
  </Section>

  <FaqSection faqs={faqs} title="Found FAQ" tone="raised" />
</Layout>
