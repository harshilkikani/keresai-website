---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import PricingPage from '../components/PricingPage.astro';
import { organizationSchema, softwareApplicationSchema, faqSchema, breadcrumbSchema } from '../data/schema';
import { pricingCopy, pricingFaqs } from '../i18n/pricing';
const p = pricingCopy('en');
const crumbs = [{ name: p.crumbs[0], path: 'en' === 'es' ? '/es' : '/' }, { name: p.crumbs[1], path: '/pricing' }];
---
<Layout title={p.title} description={p.description} path="/pricing" locale="en">
  <Schema slot="head" graph={[softwareApplicationSchema, faqSchema(pricingFaqs('en')), breadcrumbSchema(crumbs), organizationSchema]} />
  <PricingPage locale="en" />
</Layout>
