---
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { organizationSchema, faqSchema, breadcrumbSchema } from '../../data/schema';

const path = '/tools/staffing-savings-estimator';
const ORIGIN = 'https://www.keresai.com';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools' },
  { name: 'Staffing Cost Estimator', path },
];
const faqs = [
  { q: 'How much does a front-desk receptionist cost?', a: 'Beyond salary, a front-desk hire carries 20–30% in benefits and overhead, and still only covers about 40 of the 168 hours in a week. This estimator shows your fully-loaded annual cost and how much of the week stays uncovered.' },
  { q: 'Can an AI receptionist replace front-desk staff?', a: 'Many businesses use an AI receptionist for after-hours and overflow while keeping daytime staff; others run it as the full front desk. It answers unlimited calls 24/7 at a flat rate, so you get coverage without staffing nights and weekends.' },
  { q: 'How much can I save with an AI receptionist?', a: 'Savings depend on your call volume and current coverage. Keres is a flat monthly rate — typically well below a full-time hire plus a per-minute answering service. Book a demo for an exact quote against these numbers.' },
];
const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Front-Desk Staffing Cost Estimator',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: ORIGIN + path,
  description: 'Free tool that estimates the fully-loaded annual cost of front-desk phone coverage.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  provider: { '@id': `${ORIGIN}/#organization` },
};
---
<Layout
  title="Front-Desk Staffing Cost Estimator | Keres AI"
  description="Free staffing cost estimator. See the fully-loaded annual cost of front-desk phone coverage — and how many hours of the week your team still can’t answer."
  path={path}
>
  <Schema slot="head" graph={[webApp, faqSchema(faqs), breadcrumbSchema(crumbs), organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />
  <header class="page-hero container">
    <span class="eyebrow">Free tool</span>
    <h1>What does your <span class="accent">front desk cost?</span></h1>
    <p class="lead">Salary is only part of it. See the fully-loaded annual cost of phone coverage — and how much of the week still goes unanswered.</p>
  </header>

  <section class="page-section container container-narrow">
    <div class="answer-block">
      <p>A front-desk hire costs far more than salary once you add benefits and overhead — and one full-time seat still covers only about <strong>40 of the 168 hours</strong> in a week. This estimator shows your current loaded cost and the coverage gap an AI receptionist closes 24/7.</p>
    </div>

    <div class="roi-shell" style="margin-top:22px">
      <div class="roi-grid">
        <div class="roi-inputs">
          <label class="roi-field"><span class="roi-field-label">Front-desk / reception staff</span><input type="number" id="st-staff" min="0" value="1"></label>
          <label class="roi-field"><span class="roi-field-label">Avg annual salary</span><div class="roi-field-prefix"><span>$</span><input type="number" id="st-salary" min="0" value="38000"></div></label>
          <label class="roi-field"><span class="roi-field-label">Benefits & overhead %</span><input type="number" id="st-overhead" min="0" max="100" value="25"></label>
          <label class="roi-field"><span class="roi-field-label">Answering service $/mo</span><div class="roi-field-prefix"><span>$</span><input type="number" id="st-answering" min="0" value="0"></div></label>
        </div>
        <div class="roi-output">
          <div class="roi-headline-label">Your phone coverage costs</div>
          <div class="roi-headline-value"><span id="st-annual">$0</span><span class="roi-per">/yr</span></div>
          <div class="roi-headline-year">≈ <span id="st-monthly">$0</span> / month</div>
          <div class="roi-math">
            <div class="roi-math-row"><span>Loaded staffing cost</span><span id="st-row-staffing">$0</span></div>
            <div class="roi-math-row muted"><span id="st-row-staffing-calc">= staff × salary × loaded</span><span></span></div>
            <div class="roi-math-row"><span>Answering service / yr</span><span id="st-row-answering">$0</span></div>
            <div class="roi-math-row"><span>Week still uncovered</span><span id="st-uncovered">0%</span></div>
            <div class="roi-math-row muted"><span id="st-row-coverage">0 of 168 hrs/week covered</span><span></span></div>
          </div>
          <a class="btn btn-primary" href="/demo">Get a Keres quote vs. these numbers →</a>
          <div class="roi-note">Keres answers 24/7 at a flat rate. Book a demo to compare against your exact cost.</div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection faqs={faqs} title="Staffing cost FAQ" />
  <CtaBand heading="Cover the phones without hiring" sub="Book a demo and we’ll quote 24/7 coverage against your current staffing cost." />

  <script slot="scripts" src="/assets/staffing.js?v=1" is:inline></script>
</Layout>
