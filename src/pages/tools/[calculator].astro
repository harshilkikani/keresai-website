---
import { calcDefaultResult, usd } from '../../data/calcDefaults';
import Layout from '../../layouts/Layout.astro';
import Schema from '../../components/Schema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSection from '../../components/FaqSection.astro';
import CtaBand from '../../components/CtaBand.astro';
import { organizationSchema, faqSchema, breadcrumbSchema, webPageSchema, toolSchema } from '../../data/schema';
import { calculators } from '../../data/calculators';

export function getStaticPaths() {
  return calculators.map((c) => ({ params: { calculator: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const path = `/tools/${c.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools' },
  { name: c.h1.replace(/^What (is|are) /, '').replace(/\?$/, ''), path },
];

const webpage = webPageSchema({
  path,
  name: c.title,
  description: c.description,
  speakableSelectors: ['.answer-block', '.faq-a'],
});
const calcOut = calcDefaultResult(c);
---
<Layout title={c.title} description={c.description} path={path}>
  <Schema slot="head" graph={[toolSchema({ path, name: c.title.replace(/\s*\|\s*Keres AI$/, ''), description: c.description }), faqSchema(c.faqs), breadcrumbSchema(crumbs), webpage, organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />

  <header class="page-hero container">
    <span class="eyebrow">{c.eyebrow}</span>
    <h1>{c.h1} <span class="accent">{c.h1Accent}</span></h1>
    <p class="lead">{c.lead}</p>
  </header>

  <section class="page-section container">
    <div class="answer-block">
      <p set:html={c.answer} />
    </div>
  </section>

  <section class="page-section container container-narrow">
    <div class="calc-shell" data-calc-kind={c.kind} data-calc-close={c.closeRate}>
      <div class="roi-grid">
        <div class="roi-inputs">
          {c.fields.map((f) => (
            <label class="roi-field">
              <span class="roi-field-label">{f.label}</span>
              {f.prefix ? (
                <div class="roi-field-prefix">
                  <span>{f.prefix}</span>
                  <input type="number" data-calc-field={f.id} value={f.default} min={f.min} max={f.max} />
                </div>
              ) : (
                <input type="number" data-calc-field={f.id} value={f.default} min={f.min} max={f.max} />
              )}
            </label>
          ))}
        </div>
        <div class="roi-output">
          <div class="roi-headline-label">{c.resultLabel}</div>
          <div class="roi-headline-value"><span data-calc-out="primary">{usd(calcOut.primary)}</span><span class="roi-per">{c.perLabel}</span></div>
          <div class="roi-headline-year">≈ <span data-calc-out="secondary">{usd(calcOut.secondary)}</span> {c.secondaryLabel}</div>
          <div class="roi-math" data-calc-steps></div>
          <a class="btn btn-primary" data-calc-cta href="/quote">Get a quote with these numbers →</a>
          <div class="roi-note">{c.note}</div>
        </div>
      </div>
    </div>
  </section>

  {(c.example || c.formula || c.assumptions || c.nextSteps) && (
    <section class="page-section container container-narrow">
      <div class="prose">
        {c.example && (<><h2>What does a typical example look like?</h2><p set:html={c.example} /></>)}
        {c.formula && (<><h2>How is the number calculated?</h2><p set:html={c.formula} /></>)}
        {c.assumptions && c.assumptions.length > 0 && (
          <>
            <h2>What assumptions are behind the number?</h2>
            <ul>
              {c.assumptions.map((a) => (
                <li>
                  <span set:html={a.text} />{' '}
                  {a.source
                    ? <em>Source: <a href={a.source.url} rel="noopener" target="_blank">{a.source.label}</a></em>
                    : <em>Keres AI assumption.</em>}
                </li>
              ))}
            </ul>
          </>
        )}
        {c.nextSteps && (<><h2>What should you do with this number?</h2><div set:html={c.nextSteps} /></>)}
      </div>
    </section>
  )}

  <FaqSection faqs={c.faqs} title="Calculator FAQ" />

  <section class="page-section container">
    <div class="section-label">Related</div>
    <h2 class="section-title" style="margin-bottom:8px">Keep going</h2>
    <p class="prose">
      {c.related.map((r, i) => (<>{i > 0 ? ' · ' : ''}<a href={r.href}>{r.label}</a></>))}
      {' · '}<a href="/tools">All free tools</a>
    </p>
  </section>

  <CtaBand
    heading="Turn these numbers into booked jobs"
    sub="Book a free 30-minute call and hear Remi answer, qualify and book a call."
  />

  <script slot="scripts" src="/assets/calc.js?v=1" is:inline></script>
</Layout>
