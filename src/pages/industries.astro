---
import Layout from '../layouts/Layout.astro';
import Schema from '../components/Schema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { organizationSchema, breadcrumbSchema } from '../data/schema';
import { industries } from '../data/industries';
import { hubs } from '../data/hubs';

const path = '/industries';
const ORIGIN = 'https://www.keresai.com';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Industries', path }];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Industries Keres AI serves',
  itemListElement: [
    ...hubs.map((h, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: h.name,
      url: `${ORIGIN}/industries/${h.slug}`,
    })),
    ...industries.map((ind, i) => ({
      '@type': 'ListItem',
      position: hubs.length + i + 1,
      name: ind.name,
      url: `${ORIGIN}/ai-receptionist-for-${ind.slug}`,
    })),
  ],
};
---
<Layout
  title="Industries — AI Receptionist by Industry | Keres AI"
  description="Keres AI is built for the businesses that live on the phone: HVAC, plumbing, dental, med spas, real estate, and professional intake. See the AI receptionist for your industry."
  path={path}
>
  <Schema slot="head" graph={[breadcrumbSchema(crumbs), itemList, organizationSchema]} />

  <Breadcrumbs crumbs={crumbs} />
  <header class="page-hero container">
    <span class="eyebrow">Industries</span>
    <h1>Built for the <span class="accent">businesses that live on the phone</span></h1>
    <p class="lead">From one-agent brokerages to multi-location contractors, Keres answers every call and books every lead. Find the AI receptionist tuned for your industry.</p>
    <div class="hero-ctas">
      <a href="/quote" class="btn btn-primary">Book a Demo</a>
    </div>
  </header>

  <Section spacing="standard" labelledby="hubs-title">
    <div class="k-band">
      <div class="k-band__head">
        <Eyebrow>Start here</Eyebrow>
        <h2 id="hubs-title" class="k-h2">Four verticals we build for.</h2>
        <p class="k-lede k-measure">
          Each one has its own intake script, its own vocabulary and its own integrations.
          The more specific pages underneath sit beneath these.
        </p>
      </div>
      <ul class="k-inds">
        {hubs.map((h) => (
          <li class="k-ind">
            <a class="k-ind__link" href={`/industries/${h.slug}`}>
              <h3 class="k-ind__name">{h.name}</h3>
              <p class="k-ind__line">{h.sub.split('. ')[0]}.</p>
              <span class="k-ind__go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <section class="page-section container">
    <h2 class="k-h2" style="margin-bottom:28px">Specific industries</h2>
    <div class="feature-grid">
      {industries.map((ind) => (
        <a class="feature-card" href={`/ai-receptionist-for-${ind.slug}`} style="text-decoration:none; display:block;">
          <h3>{ind.name}</h3>
          <p>{ind.intro.slice(0, 150)}…</p>
        </a>
      ))}
    </div>
  </section>

  <CtaBand heading="Don’t see your industry?" sub="Keres adapts to any phone-driven business. Book a demo and we’ll tailor it to your call flows." />
</Layout>
