---
/**
 * The only button in the system.
 *
 * variant: primary → the one accent-filled CTA. Never more than one
 *                    above the fold.
 *          ghost   → the paired secondary action. Text + arrow, no fill.
 *          outline → tertiary, used inside cards.
 *
 * `event` stamps data-event on the element so the tracking layer in
 * app.js can fire a conversion without page-specific wiring.
 */
export interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'outline';
  event?: string;
  wide?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  event,
  wide = false,
  ariaLabel,
  class: extraClass = '',
} = Astro.props;

const isExternal = href.startsWith('http');
const isTel = href.startsWith('tel:');
---
<a
  href={href}
  class:list={['btn-k', `btn-k--${variant}`, wide && 'btn-k--wide', extraClass]}
  aria-label={ariaLabel}
  data-event={event}
  {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
>
  {isTel && (
    <svg class="btn-k__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L21 14.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    </svg>
  )}
  <span class="btn-k__label"><slot /></span>
  {variant === 'ghost' && (
    <svg class="btn-k__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</a>
