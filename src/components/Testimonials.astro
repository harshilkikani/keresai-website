---
// Renders a testimonials section only when real testimonials exist.
import { testimonials } from '../data/testimonials';
---
{testimonials.length > 0 && (
  <section id="testimonials" class="alt" aria-labelledby="testi-title">
    <div class="container reveal">
      <div class="section-label">What clients say</div>
      <h2 id="testi-title" class="section-title">
        <span>Results from teams</span>
        <span class="accent">that stopped missing calls</span>
      </h2>
      <div class="feature-grid">
        {testimonials.map((t) => (
          <figure class="feature-card" style="margin:0">
            {typeof t.rating === 'number' && (
              <div aria-label={`${t.rating} out of 5`} style="color:var(--orange);letter-spacing:2px;margin-bottom:8px">
                {'★'.repeat(Math.round(t.rating))}{'☆'.repeat(5 - Math.round(t.rating))}
              </div>
            )}
            <blockquote style="margin:0 0 12px;font-size:16px;line-height:1.6">“{t.quote}”</blockquote>
            <figcaption style="font-size:13.5px;color:var(--text-dim)">
              <strong>{t.author}</strong>{t.role ? `, ${t.role}` : ''} · {t.company}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
