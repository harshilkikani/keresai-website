---
import { PHONE, EMAIL, ADDRESS, plans } from '../data/site';
import { type Locale, l } from '../i18n';
import { t } from '../i18n/ui';
import { agentsFor } from '../i18n/data';
export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const ui = t(locale);
const agents = agentsFor(locale);
const year = new Date().getFullYear();
const found = plans.find((p) => p.slug === 'found')!;
const foundFrom = found.from.replace(/^from /, `${ui.mocks.from} `);
---
<footer role="contentinfo" id="footer">
  <h2 class="visually-hidden">{ui.footer.heading}</h2>
  <div class="footer-grid">
    <div class="footer-brand">
      <a href={l(locale, '/')} class="logo" aria-label="Keres AI">
        <img src="/assets/img/KeresLogo.webp" srcset="/assets/img/KeresLogo.webp 1x, /assets/img/KeresLogo@2x.webp 2x" alt="Keres AI" class="logo-img" width="120" height="32" />
      </a>
      <p>
        {ui.footer.oneLiner}
        {ui.footer.tagline}
      </p>
      <div class="footer-contact">
        {PHONE && (
          <a href={PHONE.href} class="footer-phone" data-event="tel_click">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L21 14.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <span>{PHONE.display}</span>
          </a>
        )}
        <a href={`mailto:${EMAIL}`}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 7l9 7 9-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span>{EMAIL}</span>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h3>{ui.footer.agents}</h3>
      <ul>
        {agents.map((a) => (
          <li><a href={`/agents/${a.slug}`}>{a.name} &mdash; {a.title}</a></li>
        ))}
        <li><a href="/use-cases">{ui.footer.useCases}</a></li>
        <li><a href="/hear-it">{ui.footer.hearIt}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>{ui.footer.industries}</h3>
      <ul>
        {ui.nav.industryLinks.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h3>{ui.footer.services}</h3>
      <ul>
        <li><a href="/services">{ui.footer.allServices}</a></li>
        <li><a href="/services/found">Found &mdash; {foundFrom}</a></li>
        <li><a href={l(locale, '/custom')}>{ui.footer.customBuilds}</a></li>
        <li><a href="/integrations">{ui.footer.integrations}</a></li>
        <li><a href={l(locale, '/pricing')}>{ui.footer.pricing}</a></li>
        <li><a href="/tools">{ui.footer.freeTools}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>{ui.footer.company}</h3>
      <ul>
        <li><a href="/about">{ui.footer.about}</a></li>
        <li><a href="/trust">{ui.footer.security}</a></li>
        <li><a href="/compare">{ui.footer.compare}</a></li>
        <li><a href="/partners">{ui.footer.partners}</a></li>
        <li><a href="/contact">{ui.footer.contact}</a></li>
        <li><a href={l(locale, '/quote')}>{ui.footer.getAQuote}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>{ui.footer.legal}</h3>
      <ul>
        <li><a href="/legal/privacy.html">{ui.footer.privacy}</a></li>
        <li><a href="/legal/terms.html">{ui.footer.terms}</a></li>
        <li><a href="/legal/security.html">{ui.footer.securityPolicy}</a></li>
        <li><a href="/glossary">{ui.footer.glossary}</a></li>
      </ul>
    </div>
  </div>

  <p class="footer-address">
    Keres AI{ADDRESS.line && ` · ${ADDRESS.line}`} · <a href={`mailto:${EMAIL}`}>{EMAIL}</a>{PHONE && <> · <a href={PHONE.href} data-event="tel_click">{PHONE.display}</a></>}
  </p>

  <div class="footer-bottom">
    <div>&copy; {year} Keres AI. {ui.footer.rights}</div>
    <div>{ui.footer.never}</div>
  </div>
</footer>
