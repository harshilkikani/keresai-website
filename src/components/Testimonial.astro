---
/**
 * A single named testimonial. Renders nothing when there is no real quote:
 * no bracket, no slot. Pages hide their proof section entirely when
 * business.testimonials is empty (see src/config/business.ts).
 */
export interface Props {
  quote?: string;
  author?: string;
  role?: string;
  company?: string;
  firmType?: string;
  city?: string;
  proves?: string;
  vertical?: string;
}
const { quote, author, role, company, firmType, city } = Astro.props;
const hasQuote = Boolean(quote && author && (company || firmType));
const meta = [role, company || firmType, city].filter(Boolean).join(', ');
---
{hasQuote && (
  <figure class="k-quote">
    <blockquote class="k-quote__text">{quote}</blockquote>
    <figcaption class="k-quote__by">
      <span class="k-quote__author">{author}</span>
      <span class="k-quote__meta">{meta}</span>
    </figcaption>
  </figure>
)}
