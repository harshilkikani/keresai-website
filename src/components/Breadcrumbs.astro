---
export interface Props {
  crumbs: { name: string; path: string }[];
}
const { crumbs } = Astro.props;
---
<nav class="breadcrumbs container" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) =>
      i === crumbs.length - 1
        ? <li aria-current="page">{c.name}</li>
        : <li><a href={c.path}>{c.name}</a></li>
    )}
  </ol>
</nav>
