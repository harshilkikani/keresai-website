---
/**
 * Two-step quote form. Step 1: business, mobile, industry. Step 2: calls a
 * month, what happens to calls now. Inline validation, honeypot + timestamp,
 * no CAPTCHA. On success the confirmation renders in place: the booking
 * embed loads only then, plus "Or call … now" when a line is configured.
 *
 * Behaviour lives in /assets/quote.js (external, so the CSP stays hashed
 * inline scripts only); its messages are read from data-msg-* here so a
 * Spanish page stays Spanish. The endpoint comes from src/config/business.ts.
 */
import { PHONE } from '../data/site';
import { business } from '../config/business';
import type { Locale } from '../i18n';
import { t } from '../i18n/ui';

export interface Props {
  variant?: 'page' | 'embed';
  id?: string;
  /** Pre-selects the industry (e.g. from a /go route). */
  industry?: string;
  locale?: Locale;
}
const { variant = 'page', id = 'quote', industry = '', locale = 'en' } = Astro.props;
const f = t(locale).form;
const email = business.contactEmail;
---
<div class:list={['qf', `qf--${variant}`]} id={id} data-quote-form data-endpoint={business.formEndpoint} data-booking={business.bookingUrl}
  data-msg-required={f.msgRequired} data-msg-phone={f.msgPhone} data-msg-fast={f.msgFast} data-msg-failed={f.msgFailed} data-msg-sending={f.sending} data-msg-submit={f.submit}>
  <form class="qf__form" novalidate data-qf-form>
    <input type="hidden" name="_subject" value={f.subject} />
    <input type="hidden" name="_lang" value={locale} />
    <input type="hidden" name="_ts" value="" data-qf-ts />
    <label class="qf__hp" aria-hidden="true"><span>{f.honeypot}</span><input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>

    <ol class="qf__steps" aria-label={f.progress}>
      <li class="qf__stepdot is-current" data-qf-dot="1"><span data-figure>1</span> {f.step1}</li>
      <li class="qf__stepdot" data-qf-dot="2"><span data-figure>2</span> {f.step2}</li>
    </ol>

    <fieldset class="qf__step" data-qf-step="1">
      <legend class="qf__legend">{f.legend1}</legend>
      <div class="qf__field">
        <label class="qf__label" for={`${id}-business`}>{f.business}</label>
        <input class="qf__input" id={`${id}-business`} name="business" type="text" required autocomplete="organization" />
        <p class="qf__error" data-qf-error="business"></p>
      </div>
      <div class="qf__field">
        <label class="qf__label" for={`${id}-phone`}>{f.mobile}</label>
        <input class="qf__input" id={`${id}-phone`} name="phone" type="tel" inputmode="tel" required autocomplete="tel" placeholder="(555) 123-4567" />
        <p class="qf__error" data-qf-error="phone"></p>
      </div>
      <div class="qf__field">
        <label class="qf__label" for={`${id}-industry`}>{f.industry}</label>
        <select class="qf__input" id={`${id}-industry`} name="industry" required>
          <option value="">{f.chooseOne}</option>
          {f.industries.map(([v, lbl]) => <option value={v} selected={v === industry}>{lbl}</option>)}
        </select>
        <p class="qf__error" data-qf-error="industry"></p>
      </div>
      <button type="button" class="btn-k btn-k--primary btn-k--wide" data-qf-next>{f.next}</button>
    </fieldset>

    <fieldset class="qf__step" data-qf-step="2" hidden>
      <legend class="qf__legend">{f.legend2}</legend>
      <div class="qf__field">
        <label class="qf__label" for={`${id}-volume`}>{f.volume}</label>
        <select class="qf__input" id={`${id}-volume`} name="volume" required>
          <option value="">{f.chooseOne}</option>
          {f.volumes.map(([v, lbl]) => <option value={v}>{lbl}</option>)}
        </select>
        <p class="qf__error" data-qf-error="volume"></p>
      </div>
      <div class="qf__field">
        <label class="qf__label" for={`${id}-handling`}>{f.handling}</label>
        <select class="qf__input" id={`${id}-handling`} name="handling" required>
          <option value="">{f.chooseOne}</option>
          {f.handlings.map(([v, lbl]) => <option value={v}>{lbl}</option>)}
        </select>
        <p class="qf__error" data-qf-error="handling"></p>
      </div>
      <div class="qf__actions">
        <button type="button" class="btn-k btn-k--ghost" data-qf-back>{f.back}</button>
        <button type="submit" class="btn-k btn-k--primary" data-qf-submit>{f.submit}</button>
      </div>
      <p class="qf__error qf__error--form" data-qf-error="form" role="alert"></p>
      <p class="qf__fallback" data-qf-fallback hidden>{f.fallback} <a href={`mailto:${email}`}>{email}</a></p>
    </fieldset>
  </form>

  <div class="qf__done" data-qf-done hidden>
    <h3 class="qf__done-title">{f.doneTitle}</h3>
    <p class="qf__done-text">{f.doneText}</p>
    <div class="qf__booking" data-qf-booking aria-label={f.slots}></div>
    {PHONE && (
      <p class="qf__done-call">{f.orCall} <a href={PHONE.href} data-event="tel_click">{PHONE.display}</a> {f.now}</p>
    )}
    <p class="qf__done-contact">{f.doneContact} <a href={`mailto:${email}`}>{email}</a></p>
  </div>
</div>
