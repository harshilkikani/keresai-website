---
/** /custom in either language: a worker for one recurring job. */
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import { PHONE } from '../data/site';
import type { Locale } from '../i18n';
import { customCopy } from '../i18n/custom';

export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const c = customCopy(locale);
const h1Words = c.h1.split(' ');
---
<!-- ── HERO ───────────────────────────────────────────── -->
<Section spacing="standard" labelledby="custom-title" id="hero" class="k-hero k-hero--v2 k-hero--go">
  <div class="k-hero__light" aria-hidden="true"></div>
  <div class="k-hero__grid">
    <div class="k-hero__copy">
      <Eyebrow>{c.eyebrow}</Eyebrow>
      <h1 id="custom-title" class="k-display" data-words>
        {h1Words.map((w, i) => <><span class="w">{w}</span>{i < h1Words.length - 1 ? ' ' : ''}</>)}
      </h1>
      <div class="k-hero__ctas">
        <Button href="#scope" variant="primary" event="demo_click">{c.scope}</Button>
        {PHONE && <Button href={PHONE.href} variant="ghost" event="tel_click">{c.call} {PHONE.display}</Button>}
      </div>
      <p class="k-lede">{c.lede}</p>
    </div>
  </div>
</Section>
