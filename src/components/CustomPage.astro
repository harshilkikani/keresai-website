---
/** /custom in either language: a worker for one recurring job. */
import Section from './Section.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import DailyBrief from './DailyBrief.astro';
import ListingAgentMock from './ListingAgentMock.astro';
import OutboundMock from './OutboundMock.astro';
import { PHONE } from '../data/site';
import type { Locale } from '../i18n';
import { customCopy } from '../i18n/custom';

export interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const c = customCopy(locale);
const h1Words = c.h1.split(' ');
---
<!-- ── HERO ───────────────────────────────────────────── -->
<Section spacing="standard" labelledby="custom-title" id="hero" class="k-hero k-hero--v2 k-hero--go">
  <div class="k-hero__light" aria-hidden="true"></div>
  <div class="k-hero__grid">
    <div class="k-hero__copy">
      <Eyebrow>{c.eyebrow}</Eyebrow>
      <h1 id="custom-title" class="k-display" data-words>
        {h1Words.map((w, i) => <><span class="w">{w}</span>{i < h1Words.length - 1 ? ' ' : ''}</>)}
      </h1>
      <div class="k-hero__ctas">
        <Button href="#scope" variant="primary" event="demo_click">{c.scope}</Button>
        {PHONE && <Button href={PHONE.href} variant="ghost" event="tel_click">{c.call} {PHONE.display}</Button>}
      </div>
      <p class="k-lede">{c.lede}</p>
    </div>
  </div>
</Section>

<!-- ── THREE WE RUN ON OURSELVES ──────────────────────── -->
<Section tone="raised" spacing="major" labelledby="cases-title" id="cases">
  <div class="k-band__head">
    <Eyebrow n={1}>{c.cases.eyebrow}</Eyebrow>
    <h2 id="cases-title" class="k-h2">{c.cases.h2}</h2>
    <p class="k-lede k-measure">{c.cases.lede}</p>
  </div>
  <ul class="cases" data-reveal>
    {c.cases.items.map((it, i) => (
      <li class="case" data-reveal-child>
        <span class="case__label">{c.cases.label}</span>
        <h3 class="case__title">{it.title}</h3>
        <p class="case__job">{it.job}</p>
        <div class="case__mock">
          {i === 0 && <ListingAgentMock locale={locale} />}
          {i === 1 && <OutboundMock locale={locale} />}
          {i === 2 && <DailyBrief vertical="default" locale={locale} caption={false} />}
        </div>
      </li>
    ))}
  </ul>
</Section>

<!-- ── HOW IT WORKS ───────────────────────────────────── -->
<Section spacing="major" labelledby="how-title" id="how">
  <div class="k-band__head">
    <Eyebrow n={2}>{c.how.eyebrow}</Eyebrow>
    <h2 id="how-title" class="k-h2">{c.how.h2}</h2>
  </div>
  <ol class="k-steps k-steps--six" data-reveal>
    {c.how.steps.map(([title, text], i) => (
      <li class="k-step" data-reveal-child>
        <span class="k-step__n" data-figure>{String(i + 1).padStart(2, '0')}</span>
        <h3 class="k-step__title">{title}</h3>
        <p class="k-step__text">{text}</p>
      </li>
    ))}
  </ol>
</Section>
