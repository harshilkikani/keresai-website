---
/** Small mono label above a heading. Rule + text, never centered. */
export interface Props {
  rule?: boolean;
  class?: string;
}
const { rule = true, class: extraClass = '' } = Astro.props;
---
<p class:list={['k-eyebrow', extraClass]}>
  {rule && <span class="k-eyebrow__rule" aria-hidden="true"></span>}
  <span><slot /></span>
</p>
