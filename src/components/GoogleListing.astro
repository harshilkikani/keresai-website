---
/**
 * A managed Google Business Profile as it appears in results: stars,
 * "Open 24 hours" (because Remi answers the line), the phone number,
 * and a Call button. Depicts a third-party UI, so it borrows that UI's
 * conventions — including the green open-status dot — inside this
 * component only.
 *
 * The rating and review count belong to the fictional example business
 * and are labelled as such. They are not Keres traction.
 */
import { listingMock } from '../data/mocks';
const l = listingMock;
---
<figure class="k-listing-fig">
  <div class="listing" data-tilt>
    <div class="listing__head">
      <p class="listing__name">{l.name}</p>
      <p class="listing__cat">{l.category} · {l.area}</p>
    </div>
    <div class="listing__rating">
      <span class="listing__badge">Google</span>
      <span class="listing__num" data-figure>{l.rating}</span>
      <span class="listing__stars" aria-hidden="true">
        {[1,2,3,4,5].map(() => (
          <svg viewBox="0 0 24 24" width="14" height="14"><path d="m12 2 3 6.6 7 .8-5.2 4.8 1.4 7L12 17.7 5.8 21.2l1.4-7L2 9.4l7-.8z" fill="currentColor"/></svg>
        ))}
      </span>
      <span class="listing__reviews" data-figure>({l.reviews})</span>
    </div>
    <dl class="listing__facts">
      <div><dt>Hours</dt><dd><span class="listing__dot" aria-hidden="true"></span>{l.hours}</dd></div>
      <div><dt>Phone</dt><dd data-figure>{l.phone}</dd></div>
    </dl>
    <div class="listing__actions">
      <span class="listing__btn listing__btn--primary">Call</span>
      <span class="listing__btn">Directions</span>
      <span class="listing__btn">Website</span>
    </div>
  </div>
  <figcaption class="k-mock__caption">{l.note}. The stars are the example business’s, not ours.</figcaption>
</figure>
