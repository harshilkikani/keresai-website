---
/** The missed-call calculator. Markup here, arithmetic in /assets/roi.js,
 *  which reads its generated strings from the data-tpl-* attributes. */
import type { Locale } from '../i18n';
import { t } from '../i18n/ui';
import { ROI_DEFAULTS, roiResult, usd } from '../data/calcDefaults';
export interface Props { locale?: Locale; vertical?: string; preset?: boolean; ctaHref: string; noteId?: string }
const { locale = 'en', vertical = 'home-services', preset = false, ctaHref } = Astro.props;
const c = t(locale).calc;
const labelAttrs = Object.fromEntries(Object.entries(c.labels).map(([k, v]) => [`data-tpl-label-${k}`, v]));
// Worked default value rendered server-side (see src/data/calcDefaults.ts); roi.js recomputes on load.
const base = ROI_DEFAULTS['home-services'];
const d = preset && ROI_DEFAULTS[vertical] ? ROI_DEFAULTS[vertical] : base;
const r = roiResult(d, vertical);
const missed = r.missed, jobs = r.jobs, lostMo = r.lostMo;
---
<div class="roi-shell" data-vertical={vertical} data-preset={preset ? 'true' : undefined}
  data-tpl-note={c.note} data-tpl-missed={c.tplMissed} data-tpl-close={c.tplClose} data-tpl-job={c.tplJob} {...labelAttrs}>
  <div class="roi-vert-row">
    <label class="roi-vert-label" for="roi-vert">{c.industry}</label>
    <select id="roi-vert" class="roi-vert-select">
      {c.options.map(([v, lbl]) => <option value={v} selected={v === vertical}>{lbl}</option>)}
    </select>
  </div>
  <div class="roi-grid">
    <div class="roi-inputs">
      <label class="roi-field" for="roi-leads"><span class="roi-field-label">{c.leads}</span><input type="number" id="roi-leads" min="0" value={d.leads}></label>
      <label class="roi-field" for="roi-answer"><span class="roi-field-label">{c.answer}</span><input type="number" id="roi-answer" min="0" max="100" value={d.answer}></label>
      <label class="roi-field" for="roi-job"><span class="roi-field-label">{c.ticket}</span><div class="roi-field-prefix"><span>$</span><input type="number" id="roi-job" min="0" value={d.job}></div></label>
      <label class="roi-field" for="roi-afterhours"><span class="roi-field-label">{c.afterHours}</span><input type="number" id="roi-afterhours" min="0" max="100" value={d.ah}></label>
    </div>
    <div class="roi-output">
      <div class="roi-headline-label">{c.losing}</div>
      <div class="roi-headline-value"><span id="roi-lost-mo" data-count-live>{usd(lostMo)}</span><span class="roi-per">{c.perMo}</span></div>
      <div class="roi-headline-year">&asymp; <span id="roi-lost-yr">{usd(lostMo * 12)}</span> {c.perYear}</div>
      <div class="roi-math">
        <div class="roi-math-row"><span>{c.missed}</span><span id="roi-missed">{Math.round(missed).toLocaleString('en-US')}</span></div>
        <div class="roi-math-row muted"><span id="roi-missed-calc"></span><span></span></div>
        <div class="roi-math-row"><span>{c.jobs}</span><span id="roi-jobs">{Math.round(jobs).toLocaleString('en-US')}</span></div>
        <div class="roi-math-row muted"><span id="roi-close-calc"></span><span></span></div>
        <div class="roi-math-row"><span>{c.lost}</span><span id="roi-lost-mo-2">{usd(lostMo)}</span></div>
        <div class="roi-math-row muted"><span id="roi-job-calc"></span><span></span></div>
        <div class="roi-math-row"><span>{c.ah}</span><span id="roi-ah">{Math.round(d.leads * d.ah / 100).toLocaleString('en-US')}</span></div>
        <div class="roi-math-row muted"><span>{c.ahNote}</span><span></span></div>
      </div>
      <a id="roi-cta" class="btn-k btn-k--primary btn-k--wide" href={ctaHref} data-event="demo_click">{c.cta}</a>
      <div class="roi-note" id="roi-note"></div>
    </div>
  </div>
</div>
