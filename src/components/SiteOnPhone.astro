---
/**
 * The Be Found door's mock: a Keres-built HVAC conversion website as it
 * looks on a phone. Sticky click-to-call bar, a booking CTA wired to
 * Remi, a services list and a reviews strip — the template Found ships.
 *
 * On hover the page scrolls 40px (motion.js), which is the only thing
 * that moves. Labelled an example: the business is fictional.
 */
import PhoneFrame from './PhoneFrame.astro';
import type { Locale } from '../i18n';
import { t } from '../i18n/ui';
import { siteMockFor, siteMockTextFor } from '../i18n/data';
export interface Props { locale?: Locale; caption?: boolean }
const { locale = 'en', caption = true } = Astro.props;
const s = siteMockFor(locale);
const x = siteMockTextFor(locale);
const m = t(locale).mocks;
---
<figure class="k-site-fig">
  <PhoneFrame time="9:41" class="k-site" screen="light">
    <div class="site" data-site>
      <div class="site__page">
        <header class="site__bar">
          <span class="site__logo">{s.name}</span>
          <span class="site__call">{m.call}</span>
        </header>
        <div class="site__hero">
          <p class="site__eyebrow">{x.eyebrow}</p>
          <p class="site__h1">{s.tagline}</p>
          <p class="site__sub">{x.sub}</p>
          <span class="site__cta">{m.bookAVisit}</span>
        </div>
        <ul class="site__services">
          {s.services.map((x) => <li>{x}</li>)}
        </ul>
        <div class="site__review">
          <span class="site__stars" aria-hidden="true">
            {[1,2,3,4,5].map(() => (
              <svg viewBox="0 0 24 24" width="9" height="9"><path d="m12 2 3 6.6 7 .8-5.2 4.8 1.4 7L12 17.7 5.8 21.2l1.4-7L2 9.4l7-.8z" fill="currentColor"/></svg>
            ))}
          </span>
          <p>“{s.review.text}”</p>
          <span class="site__by">{s.review.by}</span>
        </div>
        <ul class="site__badges">
          {s.badges.map((b) => <li>{b}</li>)}
        </ul>
      </div>
      <div class="site__sticky">
        <span class="site__sticky-phone" data-figure>{s.phone}</span>
        <span class="site__sticky-btn">{m.callNow}</span>
      </div>
    </div>
  </PhoneFrame>
  {caption ? <figcaption class="k-mock__caption">{m.siteCaption}</figcaption> : <figcaption class="k-mock__caption k-mock__caption--tag">{m.example}</figcaption>}
</figure>
