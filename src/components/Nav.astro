---
import { PHONE, agents, foundServices } from '../data/site';

/**
 * Two doors, then the rest. "Be Found" opens onto the Found services;
 * "Be Answered" onto the four agents. The phone number is the button —
 * hearing Remi answer is the fastest demo there is — and "Get a quote"
 * is the quiet text link beside it.
 *
 * Dropdowns are <details>/<summary>: no JavaScript required, keyboard-
 * operable for free. app.js adds click-outside and Escape on top.
 */
const slug = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const foundLinks = foundServices.map((s) => ({
  href: `/services/found#${slug(s.name)}`,
  label: s.name,
  sub: s.addOn ? 'Add-on' : 'Included',
}));

const agentLinks = agents.map((a) => ({
  href: `/agents/${a.slug}`,
  label: a.name,
  sub: a.title,
}));

const industryLinks = [
  { href: '/industries/law-firms', label: 'Law firms' },
  { href: '/industries/home-services', label: 'Home services' },
  { href: '/industries/dental-med-spa', label: 'Dental & med spa' },
  { href: '/industries/real-estate', label: 'Real estate' },
  { href: '/industries', label: 'All industries' },
];

const resourceLinks = [
  { href: '/blog', label: 'Guides' },
  { href: '/benchmarks', label: 'Benchmarks' },
  { href: '/hear-it', label: 'Hear it — sample calls' },
  { href: '/tools', label: 'Free tools' },
  { href: '/compare', label: 'Compare' },
  { href: '/integrations', label: 'Integrations' },
  { href: '/glossary', label: 'Glossary' },
];
---
<header class="nav" role="banner" transition:persist="nav-bar">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="Keres AI. Home">
      <img src="/assets/img/KeresLogo.webp" srcset="/assets/img/KeresLogo.webp 1x, /assets/img/KeresLogo@2x.webp 2x" alt="Keres AI" class="logo-img" width="120" height="32" />
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links">
        <li>
          <details class="nav-drop">
            <summary>Be Found</summary>
            <div class="nav-drop__panel nav-drop__panel--two">
              {foundLinks.map((l) => (
                <a href={l.href}>
                  <span class="nav-drop__name">{l.label}</span>
                  <span class="nav-drop__sub">{l.sub}</span>
                </a>
              ))}
              <a href="/services/found" class="nav-drop__all">
                <span class="nav-drop__name">Everything in Found</span>
                <span class="nav-drop__sub">from $249 / month</span>
              </a>
            </div>
          </details>
        </li>

        <li>
          <details class="nav-drop">
            <summary>Be Answered</summary>
            <div class="nav-drop__panel">
              {agentLinks.map((l) => (
                <a href={l.href}>
                  <span class="nav-drop__name">{l.label}</span>
                  <span class="nav-drop__sub">{l.sub}</span>
                </a>
              ))}
              <a href="/services" class="nav-drop__all">
                <span class="nav-drop__name">All seven stages</span>
                <span class="nav-drop__sub">How the four work together</span>
              </a>
            </div>
          </details>
        </li>

        <li>
          <details class="nav-drop">
            <summary>Industries</summary>
            <div class="nav-drop__panel nav-drop__panel--plain">
              {industryLinks.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </details>
        </li>

        <li><a href="/pricing">Pricing</a></li>

        <li>
          <details class="nav-drop">
            <summary>Resources</summary>
            <div class="nav-drop__panel nav-drop__panel--plain">
              {resourceLinks.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </details>
        </li>
      </ul>
    </nav>

    <div class="nav-actions">
      <button id="theme-toggle" class="icon-btn" type="button" aria-pressed="false" aria-label="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
      </button>

      <a href="/demo" class="nav-demo-link desktop-only" data-event="demo_click">Get a quote</a>

      <a href={PHONE.href} class="nav-phone" data-event="tel_click" aria-label={`Call Keres AI on ${PHONE.display}`}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L21 14.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span class="nav-phone__num">{PHONE.display}</span>
      </a>

      <button id="hamburger" class="hamburger" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" data-open="false" aria-label="Mobile navigation" transition:persist="nav-menu">
  <p class="mobile-menu__group">Be Found</p>
  <a href="/services/found" class="mobile-menu__sub">Everything in Found &mdash; from $249</a>
  {foundLinks.slice(0, 4).map((l) => <a href={l.href} class="mobile-menu__sub">{l.label}</a>)}
  <p class="mobile-menu__group">Be Answered</p>
  {agentLinks.map((l) => <a href={l.href} class="mobile-menu__sub">{l.label} &mdash; {l.sub}</a>)}
  <a href="/services" class="mobile-menu__sub">All seven stages</a>
  <p class="mobile-menu__group">Industries</p>
  {industryLinks.map((l) => <a href={l.href} class="mobile-menu__sub">{l.label}</a>)}
  <a href="/pricing">Pricing</a>
  <p class="mobile-menu__group">Resources</p>
  {resourceLinks.map((l) => <a href={l.href} class="mobile-menu__sub">{l.label}</a>)}
  <a href="/about">About</a>
  <a href="/contact">Contact</a>
  <div class="mobile-cta">
    <a href={PHONE.href} class="btn-k btn-k--primary btn-k--wide" data-event="tel_click">Call {PHONE.display}</a>
    <a href="/demo" class="btn-k btn-k--outline btn-k--wide" data-event="demo_click">Get a quote</a>
  </div>
</div>
