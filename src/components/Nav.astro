---
import { PHONE } from '../data/site';

// Plain titles, matching the catalog. "AI receptionist" and "AI SDR"
// survive in H1s and meta descriptions where searchers use them, but
// the navigation calls the products what we call them.
const links = [
  { href: '/services', label: 'Services' },
  { href: '/services/found', label: 'Found' },
  { href: '/industries', label: 'Industries' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Resources' },
];
---
<header class="nav" role="banner">
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="Keres AI. Home">
      <img src="/assets/img/KeresLogo.png" alt="Keres AI" class="logo-img" width="120" height="32" />
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="nav-actions">
      <button id="theme-toggle" class="icon-btn" type="button" aria-pressed="false" aria-label="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
      </button>

      {/* Demo is now the quiet action; the phone is the button. */}
      <a href="/demo" class="nav-demo-link desktop-only" data-event="demo_click">Book a demo</a>

      <a href={PHONE.href} class="nav-phone" data-event="tel_click">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L21 14.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span class="nav-phone__num">{PHONE.display}</span>
      </a>

      <button id="hamburger" class="hamburger" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" data-open="false" aria-label="Mobile navigation">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
  <a href="/about">About</a>
  <a href="/contact">Contact</a>
  <div class="mobile-cta">
    <a href={PHONE.href} class="btn-k btn-k--primary btn-k--wide" data-event="tel_click">Call {PHONE.display}</a>
    <a href="/demo" class="btn-k btn-k--outline btn-k--wide" data-event="demo_click">Book a demo</a>
  </div>
</div>
