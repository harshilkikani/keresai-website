---
// Emits the page's one connected JSON-LD @graph. Nodes cross-reference each
// other by @id (#organization, #website, #webpage), so a single graph lets
// search engines and AI crawlers resolve the entity relationships instead of
// reading each block in isolation.
//
// Layout.astro builds the WebSite and WebPage-family nodes in its frontmatter
// (which always runs before its slots render) and hands them over in
// Astro.locals. This component adds them, adds the Organization when the page
// did not, and merges any nodes that share an @id, so every page ends up with
// exactly one WebPage-family node and every @id it references resolves.
//
// Usage (every page on Layout.astro renders one, even with an empty graph):
//   <Schema slot="head" graph={[organizationSchema, faqSchema(...)]} />
import { organizationSchema } from '../data/schema';

export interface Props {
  graph: Record<string, unknown>[];
}
const { graph } = Astro.props;
type Node = Record<string, unknown>;
const fromLayout = ((Astro.locals as { keresGraph?: Node[] }).keresGraph ?? []) as Node[];

// Hoist @context to the graph root; nodes keep their own @id/@type.
const strip = ({ ['@context']: _ctx, ...rest }: Node): Node => rest;
const ordered: Node[] = [];
const byId = new Map<string, Node>();
const add = (raw: Node) => {
  const node = strip(raw);
  const id = node['@id'] as string | undefined;
  if (!id) { ordered.push(node); return; }
  const seen = byId.get(id);
  if (!seen) { const copy = { ...node }; byId.set(id, copy); ordered.push(copy); return; }
  // Same entity twice (e.g. a page's speakable extension of the Layout's
  // WebPage node): merge. The first node's @type wins unless the later one
  // is more specific than a plain WebPage.
  const type = seen['@type'] === 'WebPage' && node['@type'] ? node['@type'] : seen['@type'] ?? node['@type'];
  Object.assign(seen, node, type ? { '@type': type } : {});
};
fromLayout.forEach(add);
graph.forEach(add);
if (!byId.has(organizationSchema['@id'])) add(organizationSchema);

// The page's WebPage-family node (Layout always emits it first after WebSite).
const page = fromLayout.find((n) => String(n['@id'] ?? '').endsWith('#webpage'));
const webPage = page ? byId.get(page['@id'] as string) : undefined;
if (webPage) {
  const url = webPage.url as string;
  // mainEntity: the thing the page is about, when the page defines it under
  // the conventional @id (#service, #tool, #term) and did not name another.
  if (!webPage.mainEntity) {
    const main = ['#service', '#tool', '#term'].map((h) => url + h).find((id) => byId.has(id));
    if (main) webPage.mainEntity = { '@id': main };
  }
  // speakable: only selectors whose class is in the rendered page. Indexable
  // pages that did not declare any get the answer-first blocks they have.
  const classes = (Astro.locals as { keresClasses?: Set<string> }).keresClasses;
  if (classes) {
    const exists = (sel: string) => /^\.[\w-]+$/.test(sel) && classes.has(sel.slice(1));
    const declared = (webPage.speakable as { cssSelector?: string[] } | undefined)?.cssSelector;
    const wanted = declared ?? ((Astro.locals as { keresIndexable?: boolean }).keresIndexable ? ['.answer-block', '.faq-a', '.lead'] : []);
    const kept = wanted.filter(exists);
    if (kept.length) webPage.speakable = { '@type': 'SpeakableSpecification', cssSelector: kept };
    else delete webPage.speakable;
  }
}

const doc = { '@context': 'https://schema.org', '@graph': ordered };
---
<script type="application/ld+json" set:html={JSON.stringify(doc)} />
