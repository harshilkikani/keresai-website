---
/**
 * A phone-shaped device frame with a status bar. The Daily Brief and the
 * site-on-a-phone mock both sit in one of these so they read as the same
 * object at the same fidelity.
 *
 * The frame is pure CSS: a rounded slab, a 1px inner highlight, and one
 * large soft shadow cast in a single direction. No bezel image.
 */
export interface Props {
  time?: string;
  class?: string;
  /** Dark screens (the SMS thread) vs light screens (a website). */
  screen?: 'light' | 'dark';
}
const { time = '6:00', class: extraClass = '', screen = 'light' } = Astro.props;
---
<div class:list={['ph', `ph--${screen}`, extraClass]} data-tilt>
  <div class="ph__screen">
    <div class="ph__status" aria-hidden="true">
      <span class="ph__time" data-figure>{time}</span>
      <span class="ph__notch"></span>
      <span class="ph__icons">
        <svg viewBox="0 0 16 12" width="14" height="10"><path d="M1 9h2v3H1zM5 6h2v6H5zM9 3h2v9H9zM13 0h2v12h-2z" fill="currentColor"/></svg>
        <svg viewBox="0 0 16 12" width="14" height="10"><path d="M8 10.5a1.3 1.3 0 1 0 0 .1zM4.2 7.7a5.4 5.4 0 0 1 7.6 0l-1.1 1.1a3.9 3.9 0 0 0-5.4 0zM1.4 4.9a9.4 9.4 0 0 1 13.2 0l-1.1 1.1a7.9 7.9 0 0 0-11 0z" fill="currentColor"/></svg>
        <svg viewBox="0 0 24 12" width="22" height="11"><rect x="1" y="1" width="19" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="2.5" y="2.5" width="14" height="7" rx="1.5" fill="currentColor"/><path d="M21.5 4v4a2 2 0 0 0 0-4z" fill="currentColor"/></svg>
      </span>
    </div>
    <div class="ph__body">
      <slot />
    </div>
  </div>
</div>
