---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/ai-receptionist". Combined with site origin for canonical + OG url. */
  path: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogImage = '/assets/img/og-image.png',
  noindex = false,
} = Astro.props;

const origin = 'https://www.keresai.com';
const canonical = origin + path;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : origin + ogImage;

// ── Analytics + verification ──────────────────────────────
// GoatCounter: free, privacy-friendly, cookieless (no consent banner needed).
// Claim the free code at https://www.goatcounter.com/signup (use "keresai").
// Set to '' to disable. CSP already allows gc.zgo.at + the count endpoint.
const GOATCOUNTER_CODE = 'keresai';
const goatcounterEndpoint = GOATCOUNTER_CODE ? `https://${GOATCOUNTER_CODE}.goatcounter.com/count` : '';
// Google Search Console HTML-tag verification. Prefer DNS TXT verification
// (no CSP impact); paste the token here only if you verify via the HTML tag.
const GSC_VERIFICATION = '';
---
<!DOCTYPE html>
<html lang="en" prefix="og: https://ogp.me/ns#">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light dark" />

<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' https://gc.zgo.at; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://calendly.com https://keresai.goatcounter.com; frame-src https://calendly.com; form-action 'self' https://formspree.io; base-uri 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self';" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
{goatcounterEndpoint && <script data-goatcounter={goatcounterEndpoint} async src="https://gc.zgo.at/count.js" is:inline></script>}

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Keres AI" />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
<meta name="theme-color" content="#E85D04" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonical} />

<!-- US English market. Multilingual UI is client-side only, so we do not advertise phantom localized URLs. -->
<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<link rel="icon" type="image/png" href="/assets/img/KeresLogo.png" />
<link rel="apple-touch-icon" href="/assets/img/KeresLogo.png" />
<link rel="mask-icon" href="/assets/img/KeresLogo.png" color="#E85D04" />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Keres AI — AI Receptionist & AI SDR platform" />
<meta property="og:site_name" content="Keres AI" />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@keresai" />
<meta name="twitter:creator" content="@keresai" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://formspree.io" crossorigin />
<link rel="preconnect" href="https://calendly.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/assets/styles.css?v=22" />
<link rel="stylesheet" href="/assets/pages.css?v=1" />

<!-- Page-specific structured data + head extras -->
<slot name="head" />
</head>

<body>
<a href="#main" class="skip-link">Skip to main content</a>
<Nav />
<main id="main">
  <slot />
</main>
<Footer />
<script src="/assets/app.js?v=11" is:inline></script>
<slot name="scripts" />
</body>
</html>
