---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GoNav from '../components/GoNav.astro';
import GoFooter from '../components/GoFooter.astro';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { PHONE } from '../data/site';
import { CSS_HASH } from '../data/cssHash';
import { business } from '../config/business';
import { type Locale, translatedPaths, stripLocale, localePath, ogLocale, l } from '../i18n';
import { t } from '../i18n/ui';
import { websiteSchema } from '../data/schema';
import { isIndexable } from '../seo/indexing.mjs';

export interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/agents/inbound". Combined with site origin for canonical + OG url. */
  path: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  /** Keep the page out of the index but let crawlers follow its links (thin or templated pages). */
  noindexFollow?: boolean;
  /**
   * Ad landing pages (/lp/*) render with no nav and no footer links —
   * the only things to click are the form, the phone, and the demo.
   * Setting bare also loads the tracking layer.
   */
  bare?: boolean;
  /** Ad landing chrome: logo + Call + Get a quote in the nav, a one-line footer, noindex. */
  go?: boolean;
  /**
   * Fires this conversion event on load via app.js. Used by the
   * tracked thank-you page, where the conversion is confirmed by
   * arriving rather than by a click.
   */
  conversion?: string;
  /**
   * The schema.org type of this page's one WebPage-family node: AboutPage,
   * ContactPage, CollectionPage (index/listing pages)… Defaults to WebPage.
   */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'FAQPage' | 'ItemPage';
  /** @id of the page's main entity (e.g. the Organization on /about). */
  mainEntityId?: string;
  /**
   * Which Fraunces file the LCP headline renders in, so only that one is
   * preloaded: 'display' (.k-display, weight 600) or 'serif' (legacy page
   * heroes, weight 300/400). Defaults from the path — see DISPLAY_HERO.
   */
  heroFont?: 'display' | 'serif';
}

const {
  title,
  description,
  path,
  ogType = 'website',
  ogImage = '/assets/img/og-image.png',
  noindex = false,
  noindexFollow = false,
  bare = false,
  go = false,
  conversion,
  locale = 'en',
  quoteHref,
  pageType = 'WebPage',
  mainEntityId,
  heroFont,
} = Astro.props;
const quoteTarget = quoteHref ?? (go ? '#quote' : l(locale, '/quote'));
const bookTarget = quoteHref || go ? '#book' : l(locale, '/quote') + '#book';

const ui = t(locale);
const basePath = stripLocale(path);
const hasTwin = translatedPaths.includes(basePath);

// Meta descriptions over ~160 characters get cut by search engines mid-word.
// Keep whole sentences that fit; if the first sentence alone is too long,
// cut at its last clause break. Pages can still pass a long description.
const trimDescription = (d: string): string => {
  const full = d.replace(/\s+/g, ' ').trim();
  if (full.length <= 160) return full;
  // A sentence ends at . ! or ? followed by a space or the end, so "Smith.ai" stays whole.
  const sentences = full.match(/.+?[.!?]+(?=\s|$)\s*/g) ?? [full];
  let out = '';
  for (const sentence of sentences) { if ((out + sentence).trim().length > 160) break; out += sentence; }
  out = out.trim();
  if (out.length >= 60) return out;
  // No whole sentence fits: cut at a word and mark the cut, rather than
  // ending at a comma with a period that reads like a finished (wrong) list.
  const cut = full.slice(0, 157);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:—–\s]+$/, '') + '…';
};
if (import.meta.env.KERES_REPORT_DESC) { const n = description.replace(/\s+/g, ' ').trim(); if (n.length > 160 || n.length < 70) console.warn(`DESC ${n.length} ${path} :: ${n}`); }
const seoDescription = trimDescription(description);


const origin = 'https://www.keresai.com';

// motion.js is inlined so it can stamp html[data-motion] before first
// paint without costing a render-blocking request. The CSP forbids
// 'unsafe-inline', so the policy carries this script's SHA-256 instead.
// Conversion-tracking config for /assets/tracking.js. Rendered as a JSON
// block (never executed, so the CSP is untouched); empty ids load nothing.
const trackingCfg = JSON.stringify({ ...business.tracking, phoneDisplay: business.phoneDisplay });
const trackingOn = !!(business.tracking.ga4 || business.tracking.googleAds || business.tracking.metaPixel);
// The Remi callback endpoint, when absolute, must be allowed by connect-src.
const callbackOrigin = (() => { try { return new URL(business.remiCallbackEndpoint).origin; } catch { return ''; } })();

// motion.js loads deferred from /assets; only the one-line stamp below stays
// inline, because html[data-motion] must be set before first paint so the
// hero choreography starts from its hidden state instead of flashing. Same
// guard as motion.js: nothing is stamped under reduced motion or without
// IntersectionObserver. The CSP carries the stamp's SHA-256 (no 'unsafe-inline').
const motionStamp = "(function(){var m=window.matchMedia;if((m&&m('(prefers-reduced-motion: reduce)').matches)||!('IntersectionObserver' in window))return;document.documentElement.setAttribute('data-motion','')})();";
const motionHash = "'sha256-" + createHash('sha256').update(motionStamp).digest('base64') + "'";
const motionVer = createHash('sha256').update(readFileSync(new URL('../../public/assets/motion.js', import.meta.url))).digest('hex').slice(0, 10);
const canonical = origin + path;
const isNotFound = path === '/404';
const indexable = !(noindex || go || noindexFollow);
// Markdown twin written by scripts/build-md.mjs for every sitemap URL:
// / -> /index.md, /pricing -> /pricing.md, /guides/x.html -> /guides/x.md.
// Same rule as the sitemap (isIndexable), so the link never points at a file
// that was not generated.
const markdownHref = indexable && !isNotFound && isIndexable(path)
  ? origin + (path === '/' ? '/index.md' : path.replace(/\.html$/, '') + '.md')
  : null;

// Pages whose H1 is .k-display (Fraunces 600). Everything else sets its
// headline in the legacy serif hero (Fraunces 300/400 → fraunces-400.woff2).
// Keep in step with the pages that render a .k-display H1.
const DISPLAY_HERO = [
  /^\/$/, /^\/(pricing|custom|quote|hear-it|partners|services|thank-you)$/, /^\/services\/found$/,
  /^\/agents\//, /^\/industries\/[^/]+$/, /^\/go(\/|$)/, /^\/lp\//,
];
const heroFace = heroFont ?? (DISPLAY_HERO.some((re) => re.test(basePath)) ? 'display' : 'serif');
const heroFontFile = heroFace === 'display' ? '/assets/fonts/fraunces-600.woff2' : '/assets/fonts/fraunces-400.woff2';

// The page's one WebPage-family node: language, site membership, and the link
// to its translation, so search and AI crawlers see the EN/ES pair as one
// work. Schema.astro (rendered in every page's head slot, after this
// frontmatter has run) emits it in the page's single @graph together with the
// WebSite node, and merges any page-level extension (speakable) into it.
const twinNode = (loc: Locale) => ({ '@type': 'WebPage', '@id': `${origin}${localePath(loc, basePath)}#webpage`, url: origin + localePath(loc, basePath) });
const webPageNode = {
  '@type': pageType,
  '@id': `${origin}${path}#webpage`,
  url: origin + path,
  // The brand suffix belongs to the <title>, not the page's name.
  name: title.replace(/\s*[|·–—-]\s*Keres(\s+AI)?\s*$/i, ''),
  description: seoDescription,
  inLanguage: locale === 'es' ? 'es-US' : 'en-US',
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#organization` },
  ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
  ...(hasTwin && locale === 'en' ? { workTranslation: twinNode('es') } : {}),
  ...(hasTwin && locale === 'es' ? { translationOfWork: twinNode('en') } : {}),
};
(Astro.locals as { keresGraph?: Record<string, unknown>[] }).keresGraph = [websiteSchema, webPageNode];
const ogImageAbs = ogImage.startsWith('http') ? ogImage : origin + ogImage;

// ── Analytics + verification ──────────────────────────────
// GoatCounter: free, privacy-friendly, cookieless (no consent banner needed).
// Claim the free code at https://www.goatcounter.com/signup (use "keresai").
// Set to '' to disable. CSP already allows gc.zgo.at + the count endpoint.
const GOATCOUNTER_CODE = 'keresai';
const goatcounterEndpoint = GOATCOUNTER_CODE ? `https://${GOATCOUNTER_CODE}.goatcounter.com/count` : '';
// Search-engine verification. Prefer DNS TXT verification (no CSP impact);
// paste a token here only if you verify via the HTML meta-tag method.
// GSC: Search Console → Settings → Ownership → HTML tag (content value only).
// Bing: Bing Webmaster Tools → verify → Meta tag (the content value only).
const GSC_VERIFICATION = '';
const BING_VERIFICATION = '';
// Meta Business Suite → Brand safety → Domains → Meta-tag verification. Required
// for Aggregated Event Measurement and for ads that link to this domain.
const META_DOMAIN_VERIFICATION = '';
---
<!DOCTYPE html>
<html lang={locale} prefix="og: https://ogp.me/ns#">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{business.googleSiteVerification && <meta name="google-site-verification" content={business.googleSiteVerification} />}
{business.bingSiteVerification && <meta name="msvalidate.01" content={business.bingSiteVerification} />}
<meta name="color-scheme" content="light dark" />

<!--
  default-src stays 'none'. Only the directives the ad stack actually
  needs are opened up:
    script-src  — gtag.js (GA4 + Google Ads) and fbevents.js
    connect-src — the beacon endpoints those two POST to, including the
                  Google Ads conversion (ccm/rmkt) collectors
    script-src  — plus gstatic.com for the website-call-conversion loader
    frame-src   — Google Ads conversion frames and the Meta pixel iframe
  img-src is already 'self' data: https:, which covers every tracking
  pixel, so it needs no change.
  Note there is deliberately NO 'unsafe-inline' in script-src: the GA4
  and Meta bootstraps live in /assets/tracking.js so the policy stays
  tight. Never inline a tag snippet — it will be blocked silently.
-->
<meta http-equiv="Content-Security-Policy" content={`default-src 'none'; script-src 'self' ${motionHash} https://gc.zgo.at https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://connect.facebook.net https://www.gstatic.com https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com; font-src 'self'; img-src 'self' data: https:; connect-src 'self' ${callbackOrigin} https://formspree.io https://calendly.com https://keresai.goatcounter.com https://dns.google https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://connect.facebook.net https://graph.facebook.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://pagead2.googlesyndication.com https://www.facebook.com; frame-src https://calendly.com https://td.doubleclick.net https://www.google.com https://www.googletagmanager.com https://www.facebook.com; form-action 'self' https://formspree.io; base-uri 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self';`} />
<meta name="referrer" content="strict-origin-when-cross-origin" />

{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
{BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}
{META_DOMAIN_VERIFICATION && <meta name="facebook-domain-verification" content={META_DOMAIN_VERIFICATION} />}
{goatcounterEndpoint && <script data-goatcounter={goatcounterEndpoint} async src="https://gc.zgo.at/count.js" is:inline></script>}

<title>{title}</title>
<meta name="description" content={seoDescription} />
<meta name="author" content="Keres AI" />
{(noindex || go)
  ? <meta name="robots" content="noindex, nofollow" />
  : noindexFollow
  ? <meta name="robots" content="noindex, follow" />
  : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
<meta name="theme-color" content="#C2410C" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
{!isNotFound && <link rel="canonical" href={canonical} />}
<link rel="alternate" type="application/rss+xml" title="Keres AI — Resources & Guides" href="/rss.xml" />
{markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}

<!-- hreflang only on indexable pages: a noindex page has no alternates to offer. -->
{!indexable ? null : hasTwin ? (
  <>
    <link rel="alternate" hreflang="en" href={origin + localePath('en', basePath)} />
    <link rel="alternate" hreflang="es" href={origin + localePath('es', basePath)} />
    <link rel="alternate" hreflang="x-default" href={origin + localePath('en', basePath)} />
  </>
) : (
  <>
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
  </>
)}

<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content={ogType} />
{!isNotFound && <meta property="og:url" content={canonical} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={seoDescription} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Keres AI: websites, Google Business Profile and AI receptionist for local businesses" />
<meta property="og:site_name" content="Keres AI" />
<meta property="og:locale" content={ogLocale[locale]} />
{hasTwin && <meta property="og:locale:alternate" content={ogLocale[locale === 'en' ? 'es' : 'en']} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={seoDescription} />
<meta name="twitter:image" content={ogImageAbs} />

<link rel="preconnect" href="https://formspree.io" crossorigin />
<link rel="preconnect" href="https://calendly.com" crossorigin />
<!-- Self-hosted fonts (latin subset). No third-party font CDN → faster LCP, no extra DNS/TLS. -->
<!-- The Fraunces file the LCP headline is set in (600 for .k-display heroes,
     400 for the legacy serif heroes; see DISPLAY_HERO) and DM Sans Regular
     (body). Preloading the wrong weight downloads 18KB ahead of the one the
     H1 actually waits for. -->
<link rel="preload" href={heroFontFile} as="font" type="font/woff2" crossorigin fetchpriority="high" />
<link rel="preload" href="/assets/fonts/dmsans-400.woff2" as="font" type="font/woff2" crossorigin />
<!-- One request instead of five. site.css is generated by
     scripts/build-css.mjs from fonts → tokens → styles → pages →
     components, in that order; edit those, never site.css. The query
     is a content hash, so a stale stylesheet cannot be served and no
     version number has to be bumped by hand. -->
<link rel="stylesheet" href={`/assets/site.css?v=${CSS_HASH}`} />

<!-- Page-to-page crossfade comes from CSS cross-document view transitions
     (@view-transition in components.css), with no client router: the router's
     JavaScript was the main source of blocking time on mobile. -->

<!-- Only the html[data-motion] stamp blocks, so the hero choreography starts
     from its hidden state instead of flashing visible, then hiding, then
     animating. The rest of motion.js (11KB) is deferred; it boots at
     DOMContentLoaded exactly as it did when inlined. -->
<script is:inline set:html={motionStamp}></script>
<script src={`/assets/motion.js?v=${motionVer}`} defer is:inline></script>

<!-- Page-specific structured data (one @graph, see Schema.astro) + head extras -->
<slot name="head" />
</head>

<body class:list={[bare && 'is-bare']} data-conversion={conversion}>
<a href="#main" class="skip-link">{ui.skip}</a>
{!bare && (go ? <GoNav locale={locale} path={path} /> : <Nav locale={locale} path={path} />)}
{/* Ad landing pages get a logo and a phone number and nothing else —
    no nav, no menu, nothing to click but the conversion action. */}
{bare && (
  <header class="lp-bar" role="banner">
    <div class="lp-bar__inner">
      <a href="/" class="logo" aria-label="Keres AI">
        <img src="/assets/img/KeresLogo.webp" srcset="/assets/img/KeresLogo.webp 1x, /assets/img/KeresLogo@2x.webp 2x" alt="Keres AI" class="logo-img" width="52" height="52" />
      </a>
      {PHONE && (
        <a href={PHONE.href} class="nav-phone" data-event="tel_click" aria-label={`Call Keres AI on ${PHONE.display}`}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L21 14.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          </svg>
          <span class="nav-phone__num">{PHONE.display}</span>
        </a>
      )}
    </div>
  </header>
)}
<main id="main" tabindex="-1">
  <slot />
</main>
{!bare && (go ? <GoFooter locale={locale} /> : <Footer locale={locale} />)}

{/* Sticky mobile bar: Call first, Book second. Suppressed only where the
    page IS the conversion (demo/contact) — a bare LP still gets it. */}
{basePath !== '/demo' && basePath !== '/contact' && basePath !== '/quote' && (
  <div class="sticky-bar" role="region" aria-label="Contact Keres">
    <a href={quoteTarget} class="sticky-bar__demo sticky-bar__demo--primary" data-event="demo_click">{ui.sticky.getAQuote}</a>
    {!PHONE && <a href={bookTarget} class="sticky-bar__call sticky-bar__call--secondary sticky-bar__call--book" data-event="book_click">{ui.booking.stickyBook}</a>}
    {PHONE && (
      <a href={PHONE.href} class="sticky-bar__call sticky-bar__call--secondary" data-event="tel_click">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2L21 14.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4 5.2 2 2 0 0 1 6 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
        <span>{ui.sticky.call} {PHONE.display}</span>
      </a>
    )}
  </div>
)}
<script src="/assets/app.js?v=16" defer is:inline></script>
{trackingOn && <script type="application/json" id="keres-tracking" set:html={trackingCfg}></script>}
{trackingOn && <script src="/assets/tracking.js?v=4" defer is:inline></script>}
<slot name="scripts" />
</body>
</html>
